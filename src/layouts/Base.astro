---
import "@fontsource/ibm-plex-sans/latin-300.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/base.css";
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/protect.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeftRail from "../components/rails/LeftRail.astro";
import RightRail from "../components/rails/RightRail.astro";
import { getSettings } from "../data";

interface Props {
  title?: string;
  description?: string;
  /** Seconds between automatic reloads for visitors without JavaScript (pages with live data). */
  noscriptRefresh?: number;
  /** LCP image drawn as a CSS background: preload it at high priority. */
  preloadImage?: string;
  /** HLTV-style left and right rails (on by default). */
  rails?: boolean;
}

const { title, noscriptRefresh, preloadImage, rails = true, description = "ISEC — live CS2 matches, results, events, team rankings and player stats." } =
  Astro.props;
const announcement = getSettings().announcement;
const fullTitle = title ? `${title} · ISEC` : "ISEC — CS2 esports competitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <style is:inline>@layer reset, tokens, base, layout, components, utilities;</style>
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // FOUC guard only: apply a stored colour-scheme override before first paint.
      try {
        document.querySelector('meta[name="color-scheme"]').content =
          localStorage.getItem("color-scheme") ?? "light dark";
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {
      noscriptRefresh && (
        <noscript>
          <meta http-equiv="refresh" content={String(noscriptRefresh)} />
        </noscript>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    {
      announcement && (
        <p class="announcement">
          {announcement.href ? <a href={announcement.href}>{announcement.text}</a> : announcement.text}
        </p>
      )
    }
    <div class="shell">
      <main id="main" class="page">
        <slot />
      </main>
      {
        rails && (
          <>
            <aside class="rail rail-left" aria-label="Spotlight and ranking">
              <LeftRail />
            </aside>
            <aside class="rail rail-right" aria-label="Recent activity">
              <RightRail />
            </aside>
          </>
        )
      }
    </div>
    <Footer />
    <p id="live-announcer" class="visually-hidden" role="status"></p>
  </body>
</html>

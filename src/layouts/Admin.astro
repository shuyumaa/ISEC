---
import { THEME_SCRIPT } from "../server/csp";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/base.css";
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/protect.css";
import "../styles/admin.css";
import "../styles/motion.css";
import Icon from "../components/Icon.astro";
import LogoMark from "../components/LogoMark.astro";
import { findTeam, getRequests, liveMatches } from "../data";

interface Props {
  title: string;
  error?: string;
  /** Hide navigation (sign-in page). */
  bare?: boolean;
  /** Which panel this page belongs to: the admin panel or a team's panel. */
  panel?: "admin" | "team";
}

const { title, error, bare = false, panel = "admin" } = Astro.props;
const user = Astro.locals.user;
const myTeam = panel === "team" && user?.team ? findTeam(user.team) : undefined;
const pending = !bare && panel === "admin" ? getRequests().filter((r) => r.status === "pending").length : 0;
const saved = Astro.url.searchParams.get("saved");
const path = Astro.url.pathname;
const liveCount = bare || panel === "team" ? 0 : liveMatches().length;
type NavItem = { href: string; label: string; exact?: boolean; count?: number };
const adminGroups: { label: string; items: NavItem[] }[] = [
  {
    label: "Run",
    items: [
      { href: "/admin/", label: "Dashboard", exact: true },
      { href: "/admin/matches/", label: "Matches", count: liveCount },
      { href: "/admin/ranking/", label: "Ranking" },
      { href: "/admin/requests/", label: "Team requests", count: pending },
    ],
  },
  {
    label: "Content",
    items: [
      { href: "/admin/events/", label: "Events" },
      { href: "/admin/teams/", label: "Teams" },
      { href: "/admin/players/", label: "Players" },
      { href: "/admin/news/", label: "News" },
      { href: "/admin/seasons/", label: "Seasons & awards" },
    ],
  },
  {
    label: "Site",
    items: [
      { href: "/admin/accounts/", label: "Accounts" },
      { href: "/admin/settings/", label: "Site settings" },
    ],
  },
];
const teamGroups: { label: string; items: NavItem[] }[] = [
  {
    label: myTeam?.name ?? "My team",
    items: [
      { href: "/team/", label: "Overview", exact: true },
      { href: "/team/profile/", label: "Team profile" },
      { href: "/team/players/", label: "Players" },
      { href: "/team/requests/", label: "Requests" },
      { href: "/team/events/", label: "Events" },
    ],
  },
];
const groups = panel === "team" ? teamGroups : adminGroups;
const home = panel === "team" ? "/team/" : "/admin/";
const current = (n: NavItem) => (n.exact ? path === n.href || path === home.slice(0, -1) : path.startsWith(n.href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <style is:inline>@layer reset, tokens, base, layout, components, utilities;</style>
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={THEME_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title} · ISEC {panel === "team" ? "Team" : "Admin"}</title>
    <link rel="expect" href="#main" blocking="render" />
  </head>
  <body class="admin">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="admin-header">
      <a href={bare ? "/" : home} class="admin-brand" aria-label={bare ? "ISEC home" : panel === "team" ? "Team panel home" : "ISEC admin home"}>
        <LogoMark height="1.5rem" />
        {!bare && <span>{panel === "team" ? "Team" : "Admin"}</span>}
      </a>
      {
        !bare && (
          <div class="admin-header-actions">
            <span class="sync-status" data-sync-status hidden>
              <span class="dot" aria-hidden="true" />
              <span class="label">Live</span>
            </span>
            {user && <span class="whoami">{user.username}</span>}
            <a href={myTeam ? `/teams/${myTeam.slug}/` : "/"} class="btn ghost small" target="_blank" rel="noopener">
              {myTeam ? "View team page" : "View site"} <Icon name="arrow" size={14} />
            </a>
            <form method="post" action="/logout/">
              <button type="submit" class="btn ghost small">Sign out</button>
            </form>
          </div>
        )
      }
    </header>

    <div class:list={["admin-shell", { bare }]}>
      {
        !bare && (
          <nav class="admin-nav" aria-label={panel === "team" ? "Team panel" : "Admin"}>
            {groups.map((g) => (
              <div class="nav-group">
                <p class="nav-group-label" aria-hidden="true">{g.label}</p>
                <ul>
                  {g.items.map((n) => (
                    <li>
                      <a href={n.href} aria-current={current(n) ? "page" : undefined}>
                        <span>{n.label}</span>
                        {n.count ? <span class="nav-count">{n.count}{n.href.includes("matches") ? " live" : " new"}</span> : null}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        )
      }
      <main id="main" class="admin-main">
        <div class="admin-title-row">
          <h1 class="admin-title">{title}</h1>
          <div class="admin-title-actions"><slot name="actions" /></div>
        </div>
        {error && <p class="notice error" role="alert">{error}</p>}
        {saved && !error && <p class="notice success" role="status">{saved}</p>}
        <slot />
      </main>
    </div>

    <p id="admin-toast" class="toast" role="status" aria-live="polite" hidden></p>
    <p id="live-announcer" class="visually-hidden" role="status"></p>

    <script>
      import "../scripts/polyfills";
      import "../scripts/theme";
      import "../scripts/time";
      import "../scripts/live";
      import "../scripts/admin";
      import "../scripts/dialogs";
    </script>
  </body>
</html>

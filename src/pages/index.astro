---
import Base from "../layouts/Base.astro";
import LiveRegion from "../components/LiveRegion.astro";
import EventCard from "../components/EventCard.astro";
import MatchRow from "../components/MatchRow.astro";
import NewsList from "../components/NewsList.astro";
import Panel from "../components/Panel.astro";
import RankingList from "../components/RankingList.astro";
import Scoreboard from "../components/Scoreboard.astro";
import {
  getArticles,
  completedMatches,
  findMatch,
  getEvents,
  getSettings,
  formatDay,
  groupByDay,
  liveMatches,
  upcomingMatches,
} from "../data";

const settings = getSettings();
const live = liveMatches();
const upcoming = upcomingMatches();
// Nothing live: news leads the page. Otherwise the admin's pinned match, or the top live match.
const pinned = settings.featuredMatch ? findMatch(settings.featuredMatch) : undefined;
const featured = live.length ? (pinned?.status === "live" ? pinned : [...live].sort((a, b) => b.stars - a.stars)[0]) : undefined;
const newsFirst = live.length === 0;
// The featured match is shown once, in the scoreboard, not again in the lists.
const notFeatured = <T extends { id: string }>(list: T[]) => list.filter((m) => m.id !== featured?.id);
const liveRest = notFeatured(live);
const upcomingDays = groupByDay(notFeatured(upcoming).slice(0, settings.homeUpcomingCount));
const results = completedMatches().slice(0, settings.homeResultsCount);
const activeEvents = getEvents().filter((e) => e.status !== "completed");
const news = getArticles();
---

<Base noscriptRefresh={30}>
  <h1 class="visually-hidden">ISEC — CS2 matches, results and rankings</h1>

  <div class="home">
    <aside class="home-left stack" aria-label="Ranking and events">
      <LiveRegion key="ranking" deps={["ranking:*", "team:*", "meta:*"]}>
        <Panel title={settings.rankingName} href="/ranking/" linkLabel="Full ranking">
          <RankingList limit={10} />
        </Panel>
      </LiveRegion>
      <LiveRegion key="events" deps={["event:*"]}>
        <Panel title="Events" href="/events/" linkLabel="All events">
          {activeEvents.map((e) => <EventCard event={e} compact />)}
        </Panel>
      </LiveRegion>
    </aside>

    <div class="home-center stack">
      <LiveRegion key="featured" deps={["match:*", "team:*", "event:*", "article:*"]}>
        {featured && <Scoreboard match={featured} link />}
        {
          newsFirst && news.length > 0 && (
            <Panel title="Latest news" id="top-news" href="/news/" linkLabel="All news">
              <NewsList items={news.slice(0, settings.homeNewsCount)} lead />
            </Panel>
          )
        }
      </LiveRegion>

      <LiveRegion key="live-now" deps={["match:*", "team:*", "event:*"]}>

      <Panel title="Live now" id="live-now">
        {
          liveRest.length ? (
            liveRest.map((m) => <MatchRow match={m} />)
          ) : (
            <p class="empty">{live.length ? "No other matches are live." : "No matches are live right now."}</p>
          )
        }
      </Panel>
      </LiveRegion>

      <LiveRegion key="upcoming" deps={["match:*", "team:*", "event:*"]}>
      <Panel title="Upcoming matches" href="/matches/" linkLabel="All matches">
        {
          upcomingDays.map((d) => (
            <>
              <h3 class="day-head">{formatDay(d.date)}</h3>
              {d.matches.map((m) => (
                <MatchRow match={m} />
              ))}
            </>
          ))
        }
      </Panel>
      </LiveRegion>

      <LiveRegion key="news" deps={["article:*", "match:*"]}>
        {
          !newsFirst && (
            <Panel title="Latest news" href="/news/" linkLabel="All news">
              <NewsList items={news.slice(0, settings.homeNewsCount)} lead />
            </Panel>
          )
        }
      </LiveRegion>
    </div>

    <aside class="home-right stack" aria-label="Recent results">
      <LiveRegion key="results" deps={["match:*", "team:*", "event:*"]}>
        <Panel title="Recent results" href="/results/" linkLabel="All results">
          {results.map((m) => <MatchRow match={m} showDate />)}
        </Panel>
      </LiveRegion>
    </aside>
  </div>
</Base>

<style>
  @layer layout {
    .home {
      display: grid;
      gap: var(--sp-07);
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "center" "right" "left";
    }

    @container page (width >= 60rem) {
      .home {
        grid-template-columns: minmax(0, 1fr) 19rem;
        grid-template-areas: "center right" "left right";
      }
    }

    @container page (width >= 84rem) {
      .home {
        grid-template-columns: 17rem minmax(0, 1fr) 21rem;
        grid-template-areas: "left center right";
      }
    }

    .home-left {
      grid-area: left;
    }
    .home-center {
      grid-area: center;
    }
    .home-right {
      grid-area: right;
    }
  }

</style>

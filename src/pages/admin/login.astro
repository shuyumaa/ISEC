---
import Admin from "../../layouts/Admin.astro";
import { checkPassword, clearFailures, createSession, readSession, recordFailure, throttled } from "../../server/auth";

const ADMIN_USER = process.env.ADMIN_USER ?? "admin";
const nextRaw = Astro.url.searchParams.get("next") ?? "/admin/";
// Only allow same-site relative redirects into the admin area.
const next = nextRaw.startsWith("/admin") && !nextRaw.startsWith("//") ? nextRaw : "/admin/";

if (readSession(Astro.cookies, Astro.url)) return Astro.redirect(next, 303);

let error: string | undefined;
if (Astro.request.method === "POST") {
  const ip = Astro.clientAddress ?? "unknown";
  const form = await Astro.request.formData();
  const username = String(form.get("username") ?? "");
  const password = String(form.get("password") ?? "");
  if (throttled(ip)) {
    error = "Too many attempts. Wait ten minutes and try again.";
  } else if (username === ADMIN_USER && checkPassword(password)) {
    clearFailures(ip);
    createSession(Astro.cookies, Astro.url);
    return Astro.redirect(next, 303);
  } else {
    recordFailure(ip);
    error = "The username or password is incorrect.";
  }
}
---

<Admin title="Sign in" error={error} bare>
  <form class="form" method="post" aria-labelledby="signin-title">
    <p id="signin-title" class="muted">Sign in to manage matches, events, teams and news.</p>
    <div class="field">
      <label for="username">Username</label>
      <input id="username" name="username" type="text" autocomplete="username" autocorrect="off" autocapitalize="none" spellcheck="false" required enterkeyhint="next" />
    </div>
    <div class="field">
      <label for="current-password">Password</label>
      <input id="current-password" name="password" type="password" autocomplete="current-password" required enterkeyhint="done" />
    </div>
    <div class="actions">
      <button type="submit" class="btn">Sign in</button>
      <button type="button" class="btn ghost small" aria-pressed="false" data-toggle-password>Show password</button>
    </div>
  </form>
</Admin>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-toggle-password]")!;
  const input = document.getElementById("current-password") as HTMLInputElement;
  toggle.addEventListener("click", () => {
    const show = input.type === "password";
    input.type = show ? "text" : "password";
    toggle.setAttribute("aria-pressed", String(show));
    toggle.textContent = show ? "Hide password" : "Show password";
  });
</script>

---
import Admin from "../../layouts/Admin.astro";
import LiveRegion from "../../components/LiveRegion.astro";
import LocalTime from "../../components/LocalTime.astro";
import MatchControl from "../../components/admin/MatchControl.astro";
import { completedMatches, event, getArticles, getEvents, getMatches, getPlayers, getRanking, getTeams, liveMatches, matchInstant, team, upcomingMatches } from "../../data";
import { listenerCount } from "../../server/bus";
import { auditLog } from "../../server/db";
import { handlePost } from "../../server/handle";
import { updateMatch } from "../../server/mutations";

// Quick actions posted from the dashboard ("Go live").
const result = await handlePost(Astro.request, (form, intent) => {
  const id = String(form.get("id") ?? "");
  updateMatch(id, intent, form);
  return { message: "Match is live" };
});
if (result instanceof Response) return result;

const live = liveMatches();
const next = upcomingMatches().slice(0, 6);
const log = auditLog(12);
const leader = getRanking()[0];
// First-run checklist: shown until the basics exist.
const setup = [
  { done: getTeams().length >= 2, label: "Add at least two teams", href: "/admin/teams/new/" },
  { done: getPlayers().length >= 10, label: "Add players (five per team)", href: "/admin/players/new/" },
  { done: getEvents().length > 0, label: "Create an event", href: "/admin/events/new/" },
  { done: getMatches().length > 0, label: "Schedule a match", href: "/admin/matches/?new=1#new" },
  { done: getMatches().some((m) => m.status !== "upcoming"), label: "Go live and score a match", href: "/admin/" },
];
const setupLeft = setup.filter((x) => !x.done).length;
const fmt = new Intl.DateTimeFormat("en-GB", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" });
---

<Admin title="Dashboard" error={result?.error}>
  <a slot="actions" class="btn" href="/admin/matches/?new=1#new">Schedule a match</a>
  <a slot="actions" class="btn ghost" href="/admin/news/new/">Write news</a>

  {
    setupLeft > 0 && (
      <section class="admin-section setup" aria-labelledby="setup-h">
        <div class="section-head">
          <h2 id="setup-h">Get the site ready</h2>
          <span class="muted">{setup.length - setupLeft} of {setup.length} done</span>
        </div>
        <progress max={setup.length} value={setup.length - setupLeft} aria-labelledby="setup-h"></progress>
        <ol class="steps">
          {setup.map((x) => (
            <li class:list={{ done: x.done }}>
              <span class="tick" aria-hidden="true">{x.done && <svg viewBox="0 0 16 16" width="12" height="12"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" /></svg>}</span>
              {x.done ? <span>{x.label}</span> : <a href={x.href}>{x.label}</a>}
              <span class="visually-hidden">{x.done ? "(done)" : "(to do)"}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <LiveRegion key="tiles" deps={["*"]}>
    <div class="tiles">
      <a href="/admin/matches/?status=live" class:list={{ "is-live": live.length > 0 }}><strong>{live.length}</strong><span>Live now</span></a>
      <a href="/admin/matches/?status=upcoming"><strong>{upcomingMatches().length}</strong><span>Upcoming</span></a>
      <a href="/admin/matches/?status=completed"><strong>{completedMatches().length}</strong><span>Results</span></a>
      <a href="/admin/teams/"><strong>{getTeams().length}</strong><span>Teams · {getPlayers().length} players</span></a>
      <a href="/admin/ranking/"><strong>{leader ? team(leader.team).tag : "–"}</strong><span>No. 1 · {leader?.points ?? 0} pts</span></a>
      <a href="/admin/news/"><strong>{getArticles().length}</strong><span>Articles</span></a>
    </div>
  </LiveRegion>

  <section class="admin-section" aria-labelledby="live-h">
    <div class="section-head">
      <h2 id="live-h">Live score control</h2>
      <LiveRegion key="viewers" deps={["*"]}><span class="muted">{listenerCount()} viewers connected</span></LiveRegion>
    </div>
    <LiveRegion key="live-controls" deps={["match:*"]}>
      <div class="control-grid">
        {live.length ? live.map((m) => <MatchControl match={m} />) : <p class="empty">No live matches. Press "Go live" on a match below.</p>}
      </div>
    </LiveRegion>
  </section>

  <section class="admin-section" aria-labelledby="next-h">
    <div class="section-head"><h2 id="next-h">Up next</h2><a href="/admin/matches/?status=upcoming">All upcoming</a></div>
    <LiveRegion key="next" deps={["match:*"]}>
      <div class="table-wrap" role="region" aria-labelledby="next-h" tabindex="0">
        <table class="data-table">
          <thead>
            <tr><th scope="col">Match</th><th scope="col">Event</th><th scope="col">Starts (your time)</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
          </thead>
          <tbody>
            {
              next.map((m) => (
                <tr>
                  <th scope="row"><a href={`/admin/matches/${m.id}/`}>{team(m.teamA).name} vs {team(m.teamB).name}</a></th>
                  <td>{event(m.event).name} · {m.stage}</td>
                  <td><LocalTime instant={matchInstant(m)} zone={event(m.event).timeZone} format="datetime" /></td>
                  <td>
                    <form method="post" class="actions" data-enhance>
                      <input type="hidden" name="intent" value="status" />
                      <input type="hidden" name="status" value="live" />
                      <input type="hidden" name="id" value={m.id} />
                      {m.teamA && m.teamB ? <button type="submit" class="btn small">Go live</button> : <a class="btn ghost small" href={`/admin/matches/${m.id}/#details-h`}>Set teams first</a>}
                    </form>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </LiveRegion>
  </section>

  <section class="admin-section" aria-labelledby="log-h">
    <h2 id="log-h">Recent changes</h2>
    <LiveRegion key="log" deps={["*"]}>
      <ol class="log">
        {
          log.map((l) => (
            <li>
              <time datetime={l.at}>{fmt.format(new Date(l.at))} UTC</time>
              <span><strong>{l.actor}</strong> {l.action}</span>
              <code>{l.target}</code>
            </li>
          ))
        }
      </ol>
    </LiveRegion>
  </section>
</Admin>

<style>
  @layer components {
    .control-grid {
      display: grid;
      gap: var(--sp-05);
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    }
    .setup progress {
      inline-size: 100%;
      block-size: 0.5rem;
      accent-color: var(--win);
    }
    .steps {
      display: grid;
      gap: var(--sp-02);
      list-style: none;
      margin: 0;
      padding: 0;
      & li {
        display: flex;
        align-items: center;
        gap: var(--sp-03);
        min-block-size: 2rem;
      }
      & .done {
        color: var(--text-secondary);
      }
      & .done span:not(.tick) {
        text-decoration: line-through;
      }
    }
    .tick {
      display: inline-grid;
      place-items: center;
      inline-size: 1.25rem;
      block-size: 1.25rem;
      border: var(--border-width) solid var(--border-strong);
      font-size: var(--type-label);
      .done & {
        background: var(--win);
        border-color: var(--win);
        color: var(--white);
      }
    }
    .log {
      display: grid;
      list-style: none;
      padding: 0;
      & li {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        @container page (width >= 40rem) {
          grid-template-columns: 12rem minmax(0, 1fr) auto;
        }
        gap: var(--sp-04);
        padding: var(--sp-03) 0;
        border-block-end: var(--border-width) solid var(--border-subtle);
        font-size: var(--type-body-sm);
      }
      & time,
      & code {
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: var(--type-label);
      }
    }
  }
</style>

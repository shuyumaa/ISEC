---
import Admin from "../../../layouts/Admin.astro";
import ConfirmDelete from "../../../components/admin/ConfirmDelete.astro";
import CountrySelect from "../../../components/admin/CountrySelect.astro";
import EloChart from "../../../components/EloChart.astro";
import Flag from "../../../components/Flag.astro";
import Photo from "../../../components/Photo.astro";
import TeamMark from "../../../components/TeamMark.astro";
import TransferRow from "../../../components/TransferRow.astro";
import { eloSettings, findTeam, getPlayers, getRanking, playerElo, rosterOf, team, teamElo, teamTransfers, type PlayerStatus } from "../../../data";
import { handlePost } from "../../../server/handle";
import { accountsForTeam, setAccountDisabled } from "../../../server/auth";
import { PLAYER_STATUSES, deleteTeam, deleteTransfer, movePlayerInLineup, saveTeam, setPlayerStatus } from "../../../server/mutations";
import { removeUpload, saveUpload } from "../../../server/uploads";

const slug = Astro.params.slug ?? "";
const isNew = slug === "new";

const result = await handlePost(Astro.request, async (form, intent) => {
  switch (intent) {
    case "delete":
      deleteTeam(slug);
      // Its team accounts can't do anything any more: switch them off.
      for (const a of accountsForTeam(slug)) setAccountDisabled(a.id, true, Astro.locals.user?.username ?? "admin");
      return { redirect: "/admin/teams/", message: "Team deleted; its players are now free agents" };
    case "status": {
      const status = String(form.get("status") ?? "") as PlayerStatus;
      if (!PLAYER_STATUSES.includes(status)) return { message: "Nothing changed" };
      const p = setPlayerStatus(String(form.get("player") ?? ""), status);
      return { message: `${p.nickname} updated` };
    }
    case "move":
      movePlayerInLineup(slug, String(form.get("player") ?? ""), form.get("dir") === "up" ? "up" : "down");
      return { message: "Lineup order saved" };
    case "sign": {
      const p = setPlayerStatus(String(form.get("player") ?? ""), "active", slug);
      return { message: `${p.nickname} signed` };
    }
    case "delete-transfer":
      deleteTransfer(String(form.get("id") ?? ""));
      return { message: "Move removed from the history" };
    default: {
      const old = isNew ? undefined : findTeam(slug)?.logo;
      const uploaded = await saveUpload(form, "logo", "Logo");
      const logo = form.get("removeLogo") ? null : uploaded;
      const t = saveTeam(isNew ? undefined : slug, form, logo);
      if (old && (logo === null || uploaded)) await removeUpload(old);
      return { redirect: `/admin/teams/${t.slug}/`, message: isNew ? "Team created" : "Team saved" };
    }
  }
});
if (result instanceof Response) return result;

const t = isNew ? undefined : findTeam(slug);
if (!isNew && !t) return Astro.rewrite("/404");
const roster = t ? rosterOf(t.slug) : [];
const signable = t ? getPlayers().filter((p) => p.team !== t.slug && p.status !== "retired").toSorted((a, b) => Number(!!a.team) - Number(!!b.team) || a.nickname.localeCompare(b.nickname)) : [];
const elo = t ? teamElo(t.slug) : undefined;
const rankRow = t ? getRanking().find((r) => r.team === t.slug) : undefined;
const rankPos = t ? getRanking().findIndex((r) => r.team === t.slug) + 1 : 0;
const moves = t ? teamTransfers(t.slug).slice(0, 8) : [];
const LABEL = { active: "Active", benched: "Benched", free: "Free agent", retired: "Retired" } as const;
// First/last of its group (starters or bench) can't move further.
const edge = (p: (typeof roster)[number], dir: -1 | 1) => {
  const group = roster.filter((x) => (x.status === "benched") === (p.status === "benched"));
  return group[dir < 0 ? 0 : group.length - 1]?.slug === p.slug;
};
import RoleIcon from "../../../components/RoleIcon.astro";
import Icon from "../../../components/Icon.astro";
---

<Admin title={t ? t.name : "New team"} error={result?.error}>
  <a slot="actions" class="btn ghost" href="/admin/teams/">All teams</a>
  {t && <a slot="actions" class="btn ghost" href={`/teams/${t.slug}/`} target="_blank" rel="noopener">View page</a>}
  {t && <a slot="actions" class="btn ghost" href={`/admin/accounts/?new=1&team=${encodeURIComponent(t.slug)}#new`}>{accountsForTeam(t.slug).length ? `Team accounts (${accountsForTeam(t.slug).length})` : "Create a team account"}</a>}

  {
    t && (
      <div class="tiles">
        <div><strong>{rankPos ? `#${rankPos}` : "–"}</strong><span>Ranking</span></div>
        <div><strong>{rankRow?.points ?? eloSettings().start}</strong><span>Points</span></div>
        <div><strong>{elo ? `${elo.wins}–${elo.losses}` : "0–0"}</strong><span>Series W–L</span></div>
        <div><strong>{roster.filter((p) => p.status !== "benched").length}/5</strong><span>Starting five</span></div>
      </div>
    )
  }

  <section class="admin-section" aria-labelledby="team-h">
    <h2 id="team-h">Team details</h2>
    <form method="post" class="form" aria-labelledby="team-h" enctype="multipart/form-data">
      <input type="hidden" name="intent" value="team" />
      <div class="form-grid">
        <div class="field"><label for="name">Name</label><input id="name" name="name" required maxlength="60" value={t?.name ?? ""} /></div>
        <div class="field"><label for="tag">Tag (2–4 letters)</label><input id="tag" name="tag" required minlength="2" maxlength="4" pattern="[\p{L}\p{N}]{2,4}" value={t?.tag ?? ""} /></div>
        <div class="field"><label for="countryCode">Country</label><CountrySelect id="countryCode" value={t?.countryCode} required /></div>
        <div class="field"><label for="founded">Founded</label><input id="founded" name="founded" type="number" required min="1990" max="2100" value={t?.founded ?? 2026} /></div>
        <div class="field"><label for="coach">Coach</label><input id="coach" name="coach" maxlength="60" value={t?.coach ?? ""} /></div>
        <div class="field">
          <label for="logo">Logo (PNG, JPEG or WebP, up to 5 MB)</label>
          <span class="logo-row">{t && <TeamMark team={t} size="md" />}<input id="logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp" /></span>
        </div>
      </div>
      {t?.logo && <div class="checks"><label><input type="checkbox" name="removeLogo" /> Remove the current logo</label></div>}
      <div class="actions"><button type="submit" class="btn">{isNew ? "Create team" : "Save team"}</button></div>
    </form>
  </section>

  {
    t && (
      <section class="admin-section" aria-labelledby="roster-h">
        <div class="section-head">
          <h2 id="roster-h">Roster</h2>
          <a class="btn small" href={`/admin/players/new/?team=${t.slug}`}>Add a new player</a>
        </div>
        <div class="table-wrap" role="region" aria-labelledby="roster-h" tabindex="0">
          <table class="data-table">
            <thead><tr><th scope="col">Player</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col" class="n">Elo</th><th scope="col">Since</th><th scope="col"><span class="visually-hidden">Quick actions</span></th></tr></thead>
            <tbody>
              {roster.map((p) => {
                const st = p.status ?? "active";
                return (
                  <tr>
                    <th scope="row">
                      <a class="who" href={`/admin/players/${p.slug}/`}>
                        <Photo player={p} size="thumb" />
                        <span><strong>{p.nickname}</strong><span class="muted"><Flag code={p.countryCode} label /> {p.firstName} {p.lastName}</span></span>
                      </a>
                    </th>
                    <td><span class="role-cell"><RoleIcon role={p.role} />{p.role}</span></td>
                    <td><span class:list={["badge", { green: st === "active", purple: st === "benched" }]}>{LABEL[st]}</span></td>
                    <td class="n mono">{playerElo(p.slug)?.elo ?? "—"}</td>
                    <td class="mono">{p.joined ?? "—"}</td>
                    <td>
                      <form method="post" class="row-actions" data-enhance>
                        <input type="hidden" name="intent" value="status" />
                        <input type="hidden" name="player" value={p.slug} />
                        {st === "active" ? <button class="btn ghost small" name="status" value="benched">Bench</button> : <button class="btn ghost small" name="status" value="active">Activate</button>}
                        <button class="btn ghost small" name="status" value="free">Release</button>
                        <a class="btn ghost small" href={`/admin/players/${p.slug}/`}>Edit</a>
                      </form>
                      <form method="post" class="order-btns" data-enhance>
                        <input type="hidden" name="intent" value="move" />
                        <input type="hidden" name="player" value={p.slug} />
                        <button class="btn ghost small icon-only" name="dir" value="up" disabled={edge(p, -1)} aria-label={`Move ${p.nickname} up`} title="Move up"><Icon name="up" size={14} /></button>
                        <button class="btn ghost small icon-only" name="dir" value="down" disabled={edge(p, 1)} aria-label={`Move ${p.nickname} down`} title="Move down"><Icon name="down" size={14} /></button>
                      </form>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          {roster.length === 0 && <p class="empty">No players yet. Add a new player, or sign one below.</p>}
        </div>
        {signable.length > 0 && (
          <form method="post" class="sign-row" data-enhance>
            <input type="hidden" name="intent" value="sign" />
            <div class="field">
              <label for="sign-player">Sign a player</label>
              <select id="sign-player" name="player" required>
                <option value="">Choose a player…</option>
                <optgroup label="Free agents">
                  {signable.filter((p) => !p.team).map((p) => <option value={p.slug}>{p.nickname}</option>)}
                </optgroup>
                <optgroup label="From another team (records a transfer)">
                  {signable.filter((p) => p.team).map((p) => <option value={p.slug}>{p.nickname} ({team(p.team).tag})</option>)}
                </optgroup>
              </select>
            </div>
            <button type="submit" class="btn ghost">Sign to {t.tag}</button>
          </form>
        )}
      </section>
    )
  }

  {
    t && (
      <section class="admin-section" aria-labelledby="elo-h">
        <div class="section-head">
          <h2 id="elo-h">Ranking points over time</h2>
          <a href="/admin/ranking/">How points work</a>
        </div>
        <EloChart
          label={`${t.name} Elo`}
          start={eloSettings().start}
          points={(elo?.history ?? []).map((h) => ({ label: h.date.slice(5), value: h.after, title: `${h.date}: ${h.won ? "beat" : "lost to"} ${team(h.opponent).name}, ${h.delta > 0 ? "+" : ""}${h.delta} → ${h.after}` }))}
        />
      </section>
    )
  }

  {
    t && moves.length > 0 && (
      <section class="admin-section" aria-labelledby="moves-h">
        <h2 id="moves-h">Roster moves</h2>
        <ol class="moves">{moves.map((m) => <TransferRow transfer={m} deletable />)}</ol>
      </section>
    )
  }

  {t && <div class="actions"><ConfirmDelete id="delete-team" what={t.name} action={`/admin/teams/${t.slug}/`} label="Delete team" /></div>}
</Admin>

<style>
  @layer components {
    .logo-row {
      display: flex;
      align-items: center;
      gap: var(--sp-03);
    }
    .who {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-03);
      text-decoration: none;
      color: inherit;
      & > span {
        display: grid;
      }
      & strong {
        color: var(--link);
      }
      & .muted {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-02);
      }
    }
    .row-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: end;
      gap: var(--sp-02);
    }
    .sign-row {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: var(--sp-04);
      & .field {
        min-inline-size: 16rem;
      }
    }
    .moves {
      display: grid;
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }
</style>

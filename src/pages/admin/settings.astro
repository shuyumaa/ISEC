---
import Admin from "../../layouts/Admin.astro";
import { event, getMatches, getSettings, team } from "../../data";
import { handlePost } from "../../server/handle";
import { saveSettings } from "../../server/mutations";
import { removeUpload, saveUpload } from "../../server/uploads";

const result = await handlePost(Astro.request, async (form) => {
  const before = getSettings();
  const light = await saveUpload(form, "footerLogoLight", "Light logo");
  const dark = await saveUpload(form, "footerLogoDark", "Dark logo");
  const logos = { light: form.get("removeLogoLight") ? null : light, dark: form.get("removeLogoDark") ? null : dark };
  saveSettings(form, logos);
  if (before.footerLogoLight && (logos.light === null || light)) await removeUpload(before.footerLogoLight);
  if (before.footerLogoDark && (logos.dark === null || dark)) await removeUpload(before.footerLogoDark);
  return { message: "Settings saved" };
});
if (result instanceof Response) return result;
const s = getSettings();
const candidates = getMatches().filter((m) => m.status !== "completed");
const navKeys = [
  ["matches", "Matches page"],
  ["results", "Results page"],
  ["events", "Events page"],
  ["ranking", "Team ranking page"],
  ["players", "Player rank page"],
  ["news", "News page"],
  ["season", "Season awards page"],
] as const;
---

<Admin title="Site settings" error={result?.error}>
  <form method="post" class="form" enctype="multipart/form-data">
    <fieldset>
      <legend>Names</legend>
      <div class="form-grid">
        <div class="field"><label for="rankingName">Team ranking name</label><input id="rankingName" name="rankingName" required maxlength="40" value={s.rankingName} /></div>
        <div class="field"><label for="seasonPageName">Season awards page name</label><input id="seasonPageName" name="seasonPageName" required maxlength="40" value={s.seasonPageName} /></div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Announcement bar</legend>
      <div class="form-grid">
        <div class="field wide"><label for="announcement">Text (leave empty to hide)</label><input id="announcement" name="announcement" maxlength="200" value={s.announcement?.text ?? ""} /></div>
        <div class="field wide"><label for="announcementHref">Link (optional)</label><input id="announcementHref" name="announcementHref" type="text" inputmode="url" maxlength="300" spellcheck="false" placeholder="/events/masters-s3/" value={s.announcement?.href ?? ""} /></div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Home page</legend>
      <div class="form-grid">
        <div class="field wide">
          <label for="featuredMatch">Pinned match</label>
          <select id="featuredMatch" name="featuredMatch" aria-describedby="pin-hint">
            <option value="">Automatic (most important live match)</option>
            {candidates.map((m) => <option value={m.id} selected={s.featuredMatch === m.id}>{team(m.teamA).name} vs {team(m.teamB).name} — {event(m.event).name}</option>)}
          </select>
          <span id="pin-hint" class="hint">Shown at the top while it is live. When nothing is live, news leads the page.</span>
        </div>
        <div class="field"><label for="homeNewsCount">News items</label><input id="homeNewsCount" name="homeNewsCount" type="number" min="1" max="20" required value={s.homeNewsCount} /></div>
        <div class="field"><label for="homeUpcomingCount">Upcoming matches</label><input id="homeUpcomingCount" name="homeUpcomingCount" type="number" min="1" max="30" required value={s.homeUpcomingCount} /></div>
        <div class="field"><label for="homeResultsCount">Recent results</label><input id="homeResultsCount" name="homeResultsCount" type="number" min="1" max="30" required value={s.homeResultsCount} /></div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Player rank</legend>
      <div class="form-grid">
        <div class="field"><label for="playerRankMinMaps">Minimum maps to be ranked</label><input id="playerRankMinMaps" name="playerRankMinMaps" type="number" min="0" max="50" required value={s.playerRankMinMaps} /></div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Top bar menu</legend>
      <div class="table-wrap" role="region" aria-label="Menu links" tabindex="0">
        <table class="data-table">
          <thead><tr><th scope="col">Links to</th><th scope="col">Label</th><th scope="col">Hide</th></tr></thead>
          <tbody>
            {navKeys.map(([k, what]) => (
              <tr>
                <th scope="row">{what}</th>
                <td><input name={`nav_${k}`} required maxlength="30" value={s.nav[k]} aria-label={`${what} label`} /></td>
                <td><input type="checkbox" name={`navHide_${k}`} checked={s.navHidden.includes(k)} aria-label={`Hide ${what} link`} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </fieldset>

    <fieldset>
      <legend>Side rails</legend>
      <div class="checks">
        <label><input type="checkbox" name="railLeft" checked={s.rails.left} /> Show the left rail (match, award, ranking, events)</label>
        <label><input type="checkbox" name="railRight" checked={s.rails.right} /> Show the right rail (activity, transfers)</label>
      </div>
      <p class="label">Boxes in the rails</p>
      <div class="checks">
        <label><input type="checkbox" name="boxNextMatch" checked={s.rails.nextMatch !== false} /> Next match</label>
        <label><input type="checkbox" name="boxAward" checked={s.rails.award !== false} /> Player of the week</label>
        <label><input type="checkbox" name="boxRanking" checked={s.rails.ranking !== false} /> Ranking</label>
        <label><input type="checkbox" name="boxEvents" checked={s.rails.events !== false} /> Events</label>
        <label><input type="checkbox" name="boxActivity" checked={s.rails.activity !== false} /> Recent activity</label>
        <label><input type="checkbox" name="boxTransfers" checked={s.rails.transfers !== false} /> Recent transfers</label>
      </div>
      <div class="form-grid">
        <div class="field"><label for="awardTitle">Award heading</label><input id="awardTitle" name="awardTitle" required maxlength="40" value={s.rails.awardTitle} /></div>
        <div class="field"><label for="awardSubtitle">Award name</label><input id="awardSubtitle" name="awardSubtitle" required maxlength="40" value={s.rails.awardSubtitle} /></div>
        <div class="field"><label for="rankingTitle">Ranking heading</label><input id="rankingTitle" name="rankingTitle" required maxlength="40" value={s.rails.rankingTitle} /></div>
        <div class="field"><label for="activityTitle">Activity heading</label><input id="activityTitle" name="activityTitle" required maxlength="40" value={s.rails.activityTitle} /></div>
        <div class="field"><label for="eventsTitle">Events heading</label><input id="eventsTitle" name="eventsTitle" maxlength="40" value={s.rails.eventsTitle ?? "Events"} /></div>
        <div class="field"><label for="transfersTitle">Transfers heading</label><input id="transfersTitle" name="transfersTitle" maxlength="40" value={s.rails.transfersTitle ?? "Recent transfers"} /></div>
        <div class="field"><label for="rankingCount">Teams in the ranking box</label><input id="rankingCount" name="rankingCount" type="number" min="1" max="30" value={s.rails.rankingCount ?? 5} /></div>
        <div class="field"><label for="transfersCount">Moves in the transfers box</label><input id="transfersCount" name="transfersCount" type="number" min="1" max="20" value={s.rails.transfersCount ?? 5} /></div>
      </div>
      <p class="hint">The award goes to the best rating over the 7 days up to the latest result (minimum 2 maps), calculated automatically.</p>
    </fieldset>

    <fieldset>
      <legend>Page intro lines</legend>
      <div class="form-grid">
        <div class="field wide"><label for="introMatches">Matches page</label><input id="introMatches" name="introMatches" maxlength="200" value={s.intros.matches} /></div>
        <div class="field wide"><label for="introRanking">Team ranking page (after the update date)</label><input id="introRanking" name="introRanking" maxlength="300" value={s.intros.ranking} /></div>
        <div class="field wide"><label for="introPlayerRank">Player rank page</label><input id="introPlayerRank" name="introPlayerRank" maxlength="300" value={s.intros.playerRank} /></div>
        <div class="field wide"><label for="introSeason">Season awards page</label><input id="introSeason" name="introSeason" maxlength="300" value={s.intros.season} /></div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Footer</legend>
      <div class="field wide"><label for="footerText">Footer text</label><textarea id="footerText" name="footerText" rows="2" required maxlength="300">{s.footerText}</textarea></div>
      <div class="field wide">
        <label for="footerLinks">Footer links</label>
        <textarea id="footerLinks" name="footerLinks" rows="3" spellcheck="false" aria-describedby="fl-hint">{s.footerLinks.map((l) => `${l.label} | ${l.href}`).join("\n")}</textarea>
        <span id="fl-hint" class="hint">One per line: <code>Label | /path/</code> or <code>Label | https://…</code></span>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="footerLogoLight">Footer logo, light theme</label>
          <input id="footerLogoLight" name="footerLogoLight" type="file" accept="image/png,image/jpeg,image/webp" aria-describedby="logo-hint" />
          {s.footerLogoLight && <label class="inline"><input type="checkbox" name="removeLogoLight" /> Use the built-in logo</label>}
        </div>
        <div class="field">
          <label for="footerLogoDark">Footer logo, dark theme</label>
          <input id="footerLogoDark" name="footerLogoDark" type="file" accept="image/png,image/jpeg,image/webp" aria-describedby="logo-hint" />
          {s.footerLogoDark && <label class="inline"><input type="checkbox" name="removeLogoDark" /> Use the built-in logo</label>}
        </div>
      </div>
      <p id="logo-hint" class="hint">PNG, JPEG or WebP up to 5 MB, roughly 2.2 : 1 with a transparent background. The top-bar logo is a vector and follows the bar colour.</p>
    </fieldset>

    <div class="actions"><button type="submit" class="btn">Save settings</button></div>
  </form>
</Admin>

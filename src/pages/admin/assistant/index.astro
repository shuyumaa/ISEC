---
import Admin from "../../../layouts/Admin.astro";
import Icon from "../../../components/Icon.astro";
import { PROVIDERS, aiReady, getAiConfig } from "../../../server/ai/config";
import { listChats } from "../../../server/ai/chats";

const c = getAiConfig();
const ready = aiReady();
const chats = listChats(Astro.locals.user!.username);
const suggestions = [
  "Create the event “ISEC Winter Cup 2026”, Open tier, 12–14 December, online, Asia/Shanghai.",
  "Sign the free agent … to …",
  "Schedule every match of … with TBD teams, one Bo3 every 3 hours from 10:00.",
  "Read this scoreboard and record it for match …",
];
---

<Admin title="AI assistant">
  {
    !ready ? (
      <section class="admin-section" aria-labelledby="setup-h">
        <h2 id="setup-h">Connect an AI provider</h2>
        <p class="muted">The assistant uses your own AI account: Vercel AI Gateway, OpenAI, Anthropic, Google Gemini, or any OpenAI-compatible server. Paste an API key once; it's stored encrypted.</p>
        <div class="actions"><a class="btn" href="/admin/assistant/settings/">Set up a provider</a></div>
      </section>
    ) : (
      <div class="assistant" data-assistant>
      <nav class="history" aria-label="Saved chats">
        <button type="button" class="btn small new-chat">New chat</button>
        <p class="history-empty" hidden={chats.length > 0}>Your chats are saved here.</p>
        <ol class="history-list">
          {chats.map((c) => (
            <li class="history-item" data-id={c.id}>
              <button type="button" class="history-open"><span class="history-title">{c.title}</span><time class="history-time" datetime={c.updatedAt}>{c.updatedAt.slice(0, 10)}</time></button>
            </li>
          ))}
        </ol>
      </nav>
      <section class="chat" aria-label="Conversation with the assistant">
        <div class="chat-head">
          <span class="chat-model">
            {PROVIDERS[c!.provider].label} <span class="mono">{c!.model}</span> <a href="/admin/assistant/settings/">Change</a>
          </span>
        </div>

        <div class="chat-scroll" tabindex="0" aria-label="Messages">
          <div class="chat-empty">
            <h2>What should we do?</h2>
            <p class="muted">Ask in plain words. The assistant looks things up itself and shows a card for every change; nothing is saved until you approve it.</p>
            <ul class="suggest">
              {suggestions.map((s) => <li><button type="button" class="chip" data-suggest={s}>{s}</button></li>)}
            </ul>
          </div>
          <ol class="chat-log" aria-live="polite"></ol>
          <button type="button" class="btn small jump-latest" hidden><Icon name="down" size={14} /> Jump to latest</button>
        </div>

        <div class="approve-bar" hidden>
          <span class="count"></span>
          <button type="button" class="btn small approve-all">Approve all</button>
          <button type="button" class="btn ghost small decline-all">Decline all</button>
        </div>
        <p class="chat-status" role="alert" hidden></p>

        <form class="composer">
          <label for="prompt" class="visually-hidden">Message the assistant</label>
          <textarea id="prompt" rows="2" maxlength="8000" placeholder="e.g. Move frost from Northwind to Monolith, starting today. Enter sends, Shift+Enter adds a line."></textarea>
          <div class="composer-bar">
            <label class="btn ghost small attach" for="attach"><Icon name="attach" size={16} /> Screenshot</label>
            <input id="attach" type="file" accept="image/png,image/jpeg,image/webp" multiple class="visually-hidden" />
            <span class="attach-preview" hidden></span>
            <span class="spacer"></span>
            <button type="button" class="btn ghost small stop" hidden>Stop</button>
            <button type="submit" class="btn small send">Send</button>
          </div>
        </form>
      </section>
      </div>
    )
  }
</Admin>

<script>
  import "../../../scripts/assistant";
</script>

<style>
  @layer components {
    /* The chat is the page: no page scroll below it, only the log scrolls. */
    :global(.admin-main:has(> .assistant)) {
      max-inline-size: none;
      padding-block-end: var(--sp-05);
    }
    /* History on the left, the conversation filling the rest. */
    .assistant {
      --chat-h: max(26rem, calc(100dvh - var(--header-height, 4rem) - 8.5rem));
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-04);
      @container page (width >= 52rem) {
        grid-template-columns: 15rem minmax(0, 1fr);
      }
      [hidden] {
        display: none;
      }
    }
    .history {
      box-sizing: border-box;
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr);
      gap: var(--sp-03);
      max-block-size: 14rem;
      padding: var(--sp-04);
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
      @container page (width >= 52rem) {
        max-block-size: none;
        block-size: var(--chat-h);
      }
      & .new-chat {
        inline-size: 100%;
        justify-content: center;
      }
    }
    .history-empty {
      margin: 0;
      color: var(--text-secondary);
      font-size: var(--type-body-sm);
    }
    .history-list {
      display: grid;
      align-content: start;
      list-style: none;
      margin: 0 calc(var(--sp-04) * -1);
      padding: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .history-list :global(.history-item) {
      position: relative;
      display: flex;
      align-items: center;
      &:hover :global(.history-del),
      &:focus-within :global(.history-del) {
        opacity: 1;
      }
    }
    .history-list :global(.history-open) {
      display: grid;
      flex: 1;
      min-inline-size: 0;
      gap: var(--sp-01);
      padding: var(--sp-03) 4.5rem var(--sp-03) var(--sp-04);
      border: 0;
      border-inline-start: 3px solid transparent;
      background: none;
      color: var(--text-primary);
      font: inherit;
      text-align: start;
      cursor: pointer;
      &:hover {
        background: var(--layer-hover);
      }
      &[aria-current="true"] {
        background: var(--layer-selected);
        border-inline-start-color: var(--interactive, var(--link));
      }
    }
    .history-list :global(.history-title) {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: var(--type-body-sm);
    }
    .history-list :global(.history-time) {
      color: var(--text-secondary);
      font-size: var(--type-label);
    }
    /* Floats over the row's end, so the selected highlight spans the full width. */
    .history-list :global(.history-del) {
      position: absolute;
      inset-inline-end: var(--sp-03);
      inset-block-start: 50%;
      translate: 0 -50%;
      background: var(--surface);
      padding: var(--sp-01) var(--sp-02);
      border: 0;
      color: var(--text-secondary);
      font: inherit;
      font-size: var(--type-label);
      cursor: pointer;
      opacity: 0;
      @media (hover: none) {
        opacity: 1;
      }
      &:hover,
      &:global(.confirm) {
        color: var(--loss);
        opacity: 1;
      }
    }
    .chat {
      box-sizing: border-box;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto auto auto;
      block-size: var(--chat-h);
      inline-size: 100%;
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
    }
    .chat-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-04);
      padding: var(--sp-03) var(--sp-05);
      border-block-end: var(--border-width) solid var(--border-subtle);
      font-size: var(--type-body-sm);
      & .new-chat {
        flex: none;
        white-space: nowrap;
      }
    }
    .chat-model {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--sp-02) var(--sp-03);
      min-inline-size: 0;
      color: var(--text-secondary);
      & .mono {
        color: var(--text-primary);
        overflow-wrap: anywhere;
      }
    }

    .chat-scroll {
      position: relative;
      display: grid;
      align-content: start;
      min-block-size: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      &:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: -2px;
      }
    }
    .chat-empty {
      display: grid;
      gap: var(--sp-03);
      padding: var(--sp-07) var(--sp-05) var(--sp-04);
      & h2 {
        font-size: var(--type-heading-md, 1.25rem);
      }
      & p {
        max-inline-size: 65ch;
        margin: 0;
      }
    }
    .suggest {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-02);
      list-style: none;
      margin: var(--sp-03) 0 0;
      padding: 0;
    }
    .chip {
      padding: var(--sp-02) var(--sp-04);
      border: var(--border-width) solid var(--border-subtle);
      border-radius: 1rem;
      background: var(--layer);
      color: var(--text-primary);
      font: inherit;
      font-size: var(--type-body-sm);
      text-align: start;
      cursor: pointer;
      transition: background-color var(--duration-fast-02, 110ms) ease-out;
      &:hover {
        background: var(--layer-hover);
      }
    }

    .chat-log {
      display: grid;
      align-content: start;
      gap: var(--sp-04);
      list-style: none;
      margin: 0;
      padding: var(--sp-05);
      &:empty {
        display: none;
      }
    }
    .chat-log :global(.msg) {
      display: grid;
      justify-items: start;
      gap: var(--sp-03);
      min-inline-size: 0;
    }
    .chat-log :global(.msg.user) {
      justify-items: end;
    }
    .chat-log :global(.msg-text) {
      box-sizing: border-box;
      max-inline-size: min(75ch, 100%);
      padding: var(--sp-03) var(--sp-04);
      line-height: 1.5;
      overflow-wrap: anywhere;
      & :global(p),
      & :global(ul) {
        margin: 0;
      }
      & :global(p + p),
      & :global(p + ul),
      & :global(ul + p) {
        margin-block-start: var(--sp-03);
      }
      & :global(ul) {
        padding-inline-start: 1.25rem;
      }
      & :global(code) {
        font-family: var(--font-mono);
        font-size: 0.9em;
      }
    }
    .chat-log :global(.msg.user .msg-text) {
      max-inline-size: min(60ch, 85%);
      background: var(--layer-selected);
      white-space: pre-wrap;
    }
    .chat-log :global(.msg-img) {
      max-inline-size: min(22rem, 100%);
      border: var(--border-width) solid var(--border-subtle);
    }
    .chat-log :global(.msg-file) {
      color: var(--text-secondary);
      font-size: var(--type-label);
    }
    .chat-log :global(.thinking) {
      display: flex;
      align-items: center;
      gap: var(--sp-03);
      padding-inline: var(--sp-04);
      color: var(--text-secondary);
      font-size: var(--type-body-sm);
    }
    /* Three dots that breathe while the model works (static with reduced motion). */
    .chat-log :global(.dots) {
      inline-size: 1.75rem;
      block-size: 0.5rem;
      background: radial-gradient(circle closest-side, currentColor 90%, transparent) 0 50% / 0.5rem 0.5rem repeat-x;
      opacity: 0.7;
      @media (prefers-reduced-motion: no-preference) {
        animation: breathe 1.2s ease-in-out infinite;
      }
    }
    @keyframes breathe {
      50% {
        opacity: 0.25;
      }
    }
    .chat-log :global(.tool-read) {
      padding-inline: var(--sp-04);
      font-size: var(--type-label);
      color: var(--text-secondary);
      &:global(.failed) {
        color: var(--loss);
      }
    }
    .chat-log :global(.tool-card) {
      box-sizing: border-box;
      display: grid;
      gap: var(--sp-03);
      inline-size: min(34rem, 100%);
      padding: var(--sp-04);
      background: var(--layer);
      border: var(--border-width) solid var(--border-subtle);
      border-block-start: 2px solid var(--border-strong);
    }
    .chat-log :global(.tool-card[data-state="approval-requested"]) {
      border-block-start-color: var(--interactive, var(--link));
    }
    .chat-log :global(.tool-card[data-state="output-available"]) {
      border-block-start-color: var(--win);
    }
    .chat-log :global(.tool-card[data-state="output-error"]) {
      border-block-start-color: var(--loss);
    }
    .chat-log :global(.tool-head) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-03);
    }
    .chat-log :global(.tool-fields) {
      display: grid;
      gap: var(--sp-01);
      margin: 0;
      font-size: var(--type-body-sm);
      & :global(div) {
        display: grid;
        grid-template-columns: 9rem minmax(0, 1fr);
        gap: var(--sp-03);
      }
      & :global(dt) {
        color: var(--text-secondary);
        overflow-wrap: anywhere;
      }
      & :global(dd) {
        margin: 0;
        overflow-wrap: anywhere;
      }
    }
    .chat-log :global(.tool-more) {
      font-size: var(--type-body-sm);
      & :global(summary) {
        cursor: pointer;
        color: var(--link);
        margin-block-end: var(--sp-02);
      }
    }
    .chat-log :global(.tool-error) {
      margin: 0;
      color: var(--loss);
      font-size: var(--type-body-sm);
    }
    .chat-log :global(.tool-actions) {
      display: flex;
      gap: var(--sp-03);
    }

    /* Sticks to the bottom of the scroller while the reader is scrolled up. */
    .jump-latest {
      position: sticky;
      inset-block-end: var(--sp-04);
      justify-self: center;
      margin-block: var(--sp-02) var(--sp-04);
      box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
    }

    .approve-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-03);
      padding: var(--sp-03) var(--sp-05);
      background: var(--tag-blue-bg);
      color: var(--tag-blue-fg);
      font-size: var(--type-body-sm);
      & .count {
        flex: 1;
        font-weight: 600;
      }
    }
    .chat-status {
      margin: 0;
      padding: var(--sp-03) var(--sp-05);
      color: var(--loss);
      font-size: var(--type-body-sm);
      border-block-start: var(--border-width) solid var(--border-subtle);
    }
    .composer {
      display: grid;
      gap: var(--sp-02);
      padding: var(--sp-04) var(--sp-05);
      border-block-start: var(--border-width) solid var(--border-subtle);
      /* The id outweighs the generic admin textarea size. */
      & #prompt {
        box-sizing: border-box;
        inline-size: 100%;
        resize: none;
        /* Grows with the message, up to a limit, then scrolls inside. */
        field-sizing: content;
        block-size: auto;
        min-block-size: 2lh;
        max-block-size: 8lh;
      }
    }
    .composer-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-03);
      & .spacer {
        flex: 1;
      }
    }
    .composer:has(#attach:focus-visible) .attach {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }
    .attach-preview {
      display: inline-flex;
      flex-wrap: wrap;
      gap: var(--sp-02);
    }
    .attach-preview :global(.attach-chip) {
      padding: 0 var(--sp-03);
      border-radius: 1rem;
      background: var(--tag-blue-bg);
      color: var(--tag-blue-fg);
      font-size: var(--type-label);
      line-height: 1.5rem;
    }
  }
</style>

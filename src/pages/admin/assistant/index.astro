---
import Admin from "../../../layouts/Admin.astro";
import Icon from "../../../components/Icon.astro";
import { PROVIDERS, aiReady, getAiConfig } from "../../../server/ai/config";

const c = getAiConfig();
const ready = aiReady();
const suggestions = [
  "Create the event “ISEC Winter Cup 2026”, Open tier, 12–14 December, online, Asia/Shanghai.",
  "Sign the free agent … to …",
  "Schedule a Bo3 quarter-final in … on Saturday 15:00 between … and …",
  "Read this scoreboard and record it for match …",
];
---

<Admin title="AI assistant">
  <a slot="actions" class="btn ghost" href="/admin/assistant/settings/">Provider settings</a>
  {
    !ready ? (
      <section class="admin-section setup-ai" aria-labelledby="setup-h">
        <h2 id="setup-h">Connect an AI provider</h2>
        <p class="muted">The assistant uses your own AI account: Vercel AI Gateway, OpenAI, Anthropic, Google Gemini, or any OpenAI-compatible server. Paste an API key once; it's stored encrypted.</p>
        <div class="actions"><a class="btn" href="/admin/assistant/settings/">Set up a provider</a></div>
      </section>
    ) : (
      <div class="assistant" data-assistant>
        <section class="chat" aria-label="Conversation">
          <div class="chat-head">
            <span class="muted">{PROVIDERS[c!.provider].label} · <span class="mono">{c!.model}</span></span>
            <button type="button" class="btn ghost small new-chat">New chat</button>
          </div>
          <div class="chat-empty">
            <h2>What should we do?</h2>
            <p class="muted">Ask in plain words. The assistant looks things up on its own and shows a card for every change, so nothing is saved until you approve it.</p>
            <ul class="suggest">
              {suggestions.map((s) => <li><button type="button" class="chip" data-suggest={s}>{s}</button></li>)}
            </ul>
          </div>
          <ol class="chat-log" aria-live="polite" aria-label="Messages"></ol>
          <p class="chat-status" role="status"></p>
          <form class="composer">
            <label for="prompt" class="visually-hidden">Message the assistant</label>
            <textarea id="prompt" rows="2" maxlength="4000" placeholder="e.g. Move frost from Northwind to Monolith, starting today" required={false}></textarea>
            <div class="composer-bar">
              <label class="btn ghost small attach" for="attach"><Icon name="arrow" size={14} /> Attach screenshot</label>
              <input id="attach" type="file" accept="image/png,image/jpeg,image/webp" multiple class="visually-hidden" />
              <span class="attach-preview" hidden></span>
              <span class="spacer"></span>
              <button type="button" class="btn ghost small stop" hidden>Stop</button>
              <button type="submit" class="btn small send">Send</button>
            </div>
          </form>
        </section>
      </div>
    )
  }
</Admin>

<script>
  import "../../../scripts/assistant";
</script>

<style>
  @layer components {
    .assistant {
      display: grid;
      max-inline-size: 56rem;
    }
    /* Component display rules would otherwise beat the hidden attribute. */
    .assistant [hidden] {
      display: none;
    }
    .chat {
      display: grid;
      grid-template-rows: auto auto 1fr auto auto;
      min-block-size: calc(100dvh - 14rem);
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
    }
    .chat-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-04);
      padding: var(--sp-03) var(--sp-05);
      border-block-end: var(--border-width) solid var(--border-subtle);
      font-size: var(--type-body-sm);
      & .new-chat {
        flex: none;
        white-space: nowrap;
      }
    }
    .chat-empty {
      display: grid;
      gap: var(--sp-03);
      padding: var(--sp-07) var(--sp-05) var(--sp-04);
      & h2 {
        font-size: var(--type-heading-md, 1.25rem);
      }
      & p {
        max-inline-size: 60ch;
        margin: 0;
      }
    }
    .suggest {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-02);
      list-style: none;
      margin: var(--sp-03) 0 0;
      padding: 0;
    }
    .chip {
      padding: var(--sp-02) var(--sp-04);
      border: var(--border-width) solid var(--border-subtle);
      border-radius: 1rem;
      background: var(--layer);
      color: var(--text-primary);
      font: inherit;
      font-size: var(--type-body-sm);
      text-align: start;
      cursor: pointer;
      &:hover {
        background: var(--layer-hover);
      }
    }
    .chat-log {
      display: grid;
      align-content: start;
      gap: var(--sp-04);
      list-style: none;
      margin: 0;
      padding: var(--sp-05);
      overflow-y: auto;
      max-block-size: calc(100dvh - 18rem);
      &:empty {
        display: none;
      }
    }
    .chat-log :global(.msg) {
      display: grid;
      gap: var(--sp-03);
      max-inline-size: 46rem;
    }
    .chat-log :global(.msg.user) {
      justify-self: end;
      justify-items: end;
    }
    .chat-log :global(.msg-text) {
      padding: var(--sp-03) var(--sp-04);
      line-height: 1.5;
      & :global(p),
      & :global(ul) {
        margin: 0;
      }
      & :global(p + p),
      & :global(p + ul),
      & :global(ul + p) {
        margin-block-start: var(--sp-03);
      }
      & :global(ul) {
        padding-inline-start: 1.25rem;
      }
      & :global(code) {
        font-family: var(--font-mono);
        font-size: 0.9em;
      }
    }
    .chat-log :global(.msg.user .msg-text) {
      background: var(--layer-selected);
    }
    .chat-log :global(.msg-img) {
      max-inline-size: min(22rem, 100%);
      border: var(--border-width) solid var(--border-subtle);
    }
    .chat-log :global(.tool-read) {
      font-size: var(--type-label);
      color: var(--text-secondary);
      &:global(.failed) {
        color: var(--loss);
      }
    }
    .chat-log :global(.tool-card) {
      display: grid;
      gap: var(--sp-03);
      box-sizing: border-box;
      inline-size: min(30rem, 100%);
      padding: var(--sp-04);
      background: var(--layer);
      border: var(--border-width) solid var(--border-subtle);
      border-block-start: 2px solid var(--border-strong);
    }
    .chat-log :global(.tool-card[data-state="approval-requested"]) {
      border-block-start-color: var(--interactive, var(--link));
    }
    .chat-log :global(.tool-card[data-state="output-available"]) {
      border-block-start-color: var(--win);
    }
    .chat-log :global(.tool-card[data-state="output-error"]) {
      border-block-start-color: var(--loss);
    }
    .chat-log :global(.tool-head) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-03);
    }
    .chat-log :global(.tool-fields) {
      display: grid;
      gap: var(--sp-01);
      margin: 0;
      font-size: var(--type-body-sm);
      & :global(div) {
        display: grid;
        grid-template-columns: 8rem minmax(0, 1fr);
        gap: var(--sp-03);
      }
      & :global(dt) {
        color: var(--text-secondary);
      }
      & :global(dd) {
        margin: 0;
        overflow-wrap: anywhere;
      }
    }
    .chat-log :global(.tool-error) {
      margin: 0;
      color: var(--loss);
      font-size: var(--type-body-sm);
    }
    .chat-log :global(.tool-actions) {
      display: flex;
      gap: var(--sp-03);
    }
    .chat-status {
      margin: 0;
      padding: 0 var(--sp-05);
      min-block-size: 1.25rem;
      color: var(--text-secondary);
      font-size: var(--type-body-sm);
      &:global(.is-error) {
        color: var(--loss);
      }
    }
    .composer {
      display: grid;
      gap: var(--sp-02);
      padding: var(--sp-04) var(--sp-05);
      border-block-start: var(--border-width) solid var(--border-subtle);
      & textarea {
        inline-size: 100%;
        resize: vertical;
        min-block-size: 3.5rem;
      }
    }
    .composer-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-03);
      & .spacer {
        flex: 1;
      }
    }
    .attach :global(svg) {
      rotate: -90deg;
    }
    .composer:has(#attach:focus-visible) .attach {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }
    .attach-preview {
      display: inline-flex;
      flex-wrap: wrap;
      gap: var(--sp-02);
    }
    .attach-preview :global(.attach-chip) {
      padding: 0 var(--sp-03);
      border-radius: 1rem;
      background: var(--tag-blue-bg);
      color: var(--tag-blue-fg);
      font-size: var(--type-label);
      line-height: 1.5rem;
    }
  }
</style>

---
import Admin from "../../../layouts/Admin.astro";
import ConfirmDelete from "../../../components/admin/ConfirmDelete.astro";
import EventMark from "../../../components/EventMark.astro";
import ChipGroup from "../../../components/admin/ChipGroup.astro";
import ChoiceGroup from "../../../components/admin/ChoiceGroup.astro";
import { findEvent, getEvents, getPlayers, getTeams, matchesForEvent, team } from "../../../data";
import { handlePost } from "../../../server/handle";
import { EVENT_STATUSES, MAP_POOL, TIERS, deleteEvent, generateBracket, saveEvent } from "../../../server/mutations";
import { PLAY_ORDER } from "../../../data/gsl";
import { removeUpload, saveUpload } from "../../../server/uploads";

const slug = Astro.params.slug ?? "";
const isNew = slug === "new";

const result = await handlePost(Astro.request, async (form, intent) => {
  if (intent === "delete") {
    const old = findEvent(slug);
    deleteEvent(slug);
    await removeUpload(old?.trophyImage);
    await removeUpload(old?.logo);
    return { redirect: "/admin/events/", message: "Event deleted" };
  }
  if (intent === "bracket") {
    const r = generateBracket(slug, form);
    return {
      redirect: `/admin/events/${slug}/#bracket-h`,
      message: r.created ? `Bracket created: ${r.created} matches scheduled${r.existing ? `, ${r.existing} already existed` : ""}` : "All bracket matches already exist",
    };
  }
  const before = isNew ? undefined : findEvent(slug);
  const trophyUp = await saveUpload(form, "trophyImage", "Trophy photo");
  const logoUp = await saveUpload(form, "logo", "Event logo");
  const trophy = form.get("removeTrophy") ? null : trophyUp;
  const logo = form.get("removeLogo") ? null : logoUp;
  const ev = saveEvent(isNew ? undefined : slug, form, trophy, logo);
  if (before?.trophyImage && (trophy === null || trophyUp)) await removeUpload(before.trophyImage);
  if (before?.logo && (logo === null || logoUp)) await removeUpload(before.logo);
  return { redirect: `/admin/events/${ev.slug}/`, message: isNew ? "Event created" : "Event saved" };
});
if (result instanceof Response) return result;

const ev = isNew ? undefined : findEvent(slug);
if (!isNew && !ev) return Astro.rewrite("/404");
const teams = getTeams().toSorted((a, b) => a.name.localeCompare(b.name));
const zones = Intl.supportedValuesOf("timeZone");
const otherEvents = getEvents().filter((e) => e.slug !== ev?.slug);
// Award candidates: players of the attending teams.
const eligible = ev ? getPlayers().filter((p) => ev.teams.includes(p.team)).toSorted((a, b) => a.team.localeCompare(b.team) || a.nickname.localeCompare(b.nickname)) : [];
// Prize rows: the saved ones plus blanks to add more without JavaScript.
const prizeRows = [...(ev?.prizes ?? []), ...Array.from({ length: Math.max(3, 8 - (ev?.prizes.length ?? 0)) }, () => undefined)];
const pool = ev?.mapPool ?? MAP_POOL.filter((m) => m !== "Train");
const matches = ev ? matchesForEvent(ev.slug) : [];
const slotted = matches.filter((m) => m.slot).length;
const bracketCfg = ev?.bracket;
const count = (s: string) => matches.filter((m) => m.status === s).length;
const STATUS = { upcoming: "Upcoming", ongoing: "Ongoing", completed: "Completed" } as const;
---

<Admin title={ev ? ev.name : "New event"} error={result?.error}>
  <a slot="actions" class="btn ghost" href="/admin/events/">All events</a>
  {ev && <a slot="actions" class="btn ghost" href={`/events/${ev.slug}/`} target="_blank" rel="noopener">View page</a>}

  <div class="editor">
    <form method="post" class="form editor-main" enctype="multipart/form-data" id="event-form"><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
      <input type="hidden" name="intent" value="save" />

      <fieldset>
        <legend>Basics</legend>
        <div class="form-grid">
          <div class="field wide"><label for="name">Name</label><input id="name" name="name" required maxlength="100" value={ev?.name ?? ""} /></div>
          <ChoiceGroup wide name="tier" legend="Tier" value={ev?.tier ?? "Open"} options={TIERS.map((t) => ({ value: t, label: t }))} />
          <ChoiceGroup wide name="status" legend="Status" value={ev?.status ?? "upcoming"} options={EVENT_STATUSES.map((x) => ({ value: x, label: STATUS[x] }))} />
          <div class="field"><label for="startDate">Start date</label><input id="startDate" name="startDate" type="date" required value={ev?.startDate ?? ""} /></div>
          <div class="field"><label for="endDate">End date</label><input id="endDate" name="endDate" type="date" required value={ev?.endDate ?? ""} /></div>
          <div class="field">
            <label for="timeZone">Time zone</label>
            <input id="timeZone" name="timeZone" required list="zones" autocomplete="off" spellcheck="false" value={ev?.timeZone ?? "Asia/Shanghai"} aria-describedby="tz-hint" />
            <datalist id="zones">{zones.map((z) => <option value={z} />)}</datalist>
            <span id="tz-hint" class="hint">Match start times are entered in this zone.</span>
          </div>
          <div class="field"><label for="location">Location</label><input id="location" name="location" required maxlength="100" value={ev?.location ?? ""} placeholder="e.g. Beijing, China" /></div>
          <div class="field"><label for="prizePool">Prize pool (USD)</label><input id="prizePool" name="prizePool" type="number" min="0" step="1" inputmode="numeric" value={ev?.prizePool ?? 0} /></div>
          <div class="field">
            <label for="winner">Winner</label>
            <select id="winner" name="winner">
              <option value="">Not decided</option>
              {teams.map((t) => <option value={t.slug} selected={ev?.winner === t.slug}>{t.name}</option>)}
            </select>
          </div>
        </div>
        <label class="check"><input type="checkbox" name="online" checked={ev?.online} /> Online event</label>
      </fieldset>

      <fieldset>
        <legend>Teams attending <span class="muted">({ev?.teams.length ?? 0})</span></legend>
        <ChipGroup name="teams" legend="Choose the teams" options={teams.map((t) => ({ value: t.slug, label: t.name }))} selected={ev?.teams ?? []} />
        {teams.length === 0 && <p class="hint">No teams yet. <a href="/admin/teams/new/">Add a team</a> first.</p>}
      </fieldset>

      <fieldset>
        <legend>Format and stages</legend>
        <div class="field">
          <label for="format">Format, one line per stage</label>
          <textarea id="format" name="format" rows="3" placeholder={"Swiss stage, best of one\nPlayoffs, best of three"}>{ev?.format.join("\n") ?? ""}</textarea>
        </div>
        <div class="form-grid">
          <div class="field">
            <label for="swissStage">Swiss stage name prefix</label>
            <input id="swissStage" name="swissStage" maxlength="40" value={ev?.swiss?.stage ?? ""} placeholder="e.g. Swiss" aria-describedby="swiss-hint" />
          </div>
          <div class="field"><label for="swissWins">Wins to advance</label><input id="swissWins" name="swissWins" type="number" min="1" max="5" value={ev?.swiss?.wins ?? 3} /></div>
          <div class="field"><label for="swissLosses">Losses to go out</label><input id="swissLosses" name="swissLosses" type="number" min="1" max="5" value={ev?.swiss?.losses ?? 3} /></div>
        </div>
        <p id="swiss-hint" class="hint">Matches whose stage starts with this prefix (e.g. "Swiss: Round 1") build the Group play diagram. Leave empty if the event has no Swiss stage. Stages named Quarter-final, Semi-final and Final build the playoff bracket.</p>
        <ChipGroup name="mapPool" legend="Map pool" options={MAP_POOL.map((m) => ({ value: m, label: m }))} selected={pool} />
        {
          otherEvents.length > 0 && (
            <>
              <ChipGroup name="related" legend="Related events (stages of the same competition)" options={otherEvents.map((e) => ({ value: e.slug, label: e.name }))} selected={ev?.related ?? []} />
            </>
          )
        }
      </fieldset>

      <fieldset>
        <legend>Prize distribution</legend>
        <div class="table-wrap" role="region" aria-label="Prize distribution" tabindex="0">
          <table class="data-table prize-table">
            <thead><tr><th scope="col">Place</th><th scope="col">Amount (USD)</th><th scope="col">Team</th></tr></thead>
            <tbody>
              {prizeRows.map((p, i) => (
                <tr>
                  <td><input name="prizePlace" maxlength="20" value={p?.place ?? ""} placeholder={["1st", "2nd", "3rd–4th"][i] ?? ""} aria-label={`Place, row ${i + 1}`} /></td>
                  <td><input name="prizeAmount" inputmode="numeric" value={p?.prize ?? ""} aria-label={`Amount, row ${i + 1}`} /></td>
                  <td>
                    <select name="prizeTeam" aria-label={`Team, row ${i + 1}`}>
                      <option value="">Not decided</option>
                      {teams.map((t) => <option value={t.slug} selected={p?.team === t.slug}>{t.name}</option>)}
                    </select>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="hint">Empty rows are ignored. Save to get more empty rows.</p>
        <label class="check"><input type="checkbox" name="resnapshot" /> Re-capture prize rosters from current rosters (after a placement's lineup changed)</label>
      </fieldset>

      <fieldset>
        <legend>Awards</legend>
        <div class="form-grid">
          <div class="field">
            <label for="mvp">Event MVP</label>
            <select id="mvp" name="mvp">
              <option value="">Not awarded</option>
              {eligible.map((p) => <option value={p.slug} selected={ev?.mvp === p.slug}>{p.nickname} ({team(p.team).tag})</option>)}
            </select>
          </div>
        </div>
        {eligible.length > 0 && <ChipGroup name="evps" legend="EVPs (Exceptionally Valuable Players)" options={eligible.map((p) => ({ value: p.slug, label: p.nickname }))} selected={ev?.evps ?? []} />}
        {!eligible.length && <p class="hint">Tick the attending teams and save to choose MVP and EVPs.</p>}
      </fieldset>

      <div class="actions"><button type="submit" class="btn">{isNew ? "Create event" : "Save event"}</button></div>
    </form>

    <aside class="editor-side" aria-label="Images and matches">
      <div class="side-card">
        <h2 class="side-h">Event logo</h2>
        {ev && <EventMark event={ev} size="lg" />}
        <div class="field"><label for="logo">Upload (square PNG/WebP works best)</label><input id="logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp" form="event-form" /></div>
        {ev?.logo && <label class="check"><input type="checkbox" name="removeLogo" form="event-form" /> Remove the current logo</label>}
      </div>
      <div class="side-card">
        <h2 class="side-h">Trophy photo</h2>
        <p class="hint">Shown on winners' profiles. A cut-out on a transparent background looks best.</p>
        <div class="field"><label for="trophyImage">Upload</label><input id="trophyImage" name="trophyImage" type="file" accept="image/png,image/jpeg,image/webp" form="event-form" /></div>
        {ev?.trophyImage && <label class="check"><input type="checkbox" name="removeTrophy" form="event-form" /> Remove the current photo</label>}
      </div>
      {
        ev && (
          <div class="side-card">
            <h2 class="side-h">Matches</h2>
            <dl class="numbers">
              <div><dt>Live</dt><dd>{count("live")}</dd></div>
              <div><dt>Upcoming</dt><dd>{count("upcoming")}</dd></div>
              <div><dt>Played</dt><dd>{count("completed")}</dd></div>
            </dl>
            <a class="btn small" href={`/admin/matches/?new=1&event=${ev.slug}#new`}>Schedule a match here</a>
          </div>
        )
      }
      {ev && <ConfirmDelete id="delete-event" what={ev.name} action={`/admin/events/${ev.slug}/`} label="Delete event" />}
    </aside>
  </div>

  {
    ev && (
      <section class="admin-section bracket-setup" aria-labelledby="bracket-h">
        <div class="section-head">
          <h2 id="bracket-h">Bracket: two groups + playoffs</h2>
          {slotted > 0 && <a href={`/events/${ev.slug}/#brackets`} target="_blank" rel="noopener">See the bracket</a>}
        </div>
        <ul class="format-sum">
          <li><strong>Group stage</strong> Groups A and B, 8 teams each, double elimination</li>
          <li><strong>Upper bracket</strong> Quarter-finals → semi-finals → final</li>
          <li><strong>Lower bracket</strong> Round 1 → round 2 → lower final</li>
          <li><strong>Playoffs</strong> Single elimination: A2–B3 and B2–A3, then group winners in the semis, then the Grand final</li>
        </ul>
        <p class="muted">
          {slotted ? `${slotted} of ${PLAY_ORDER.length} matches exist. Creating again only adds the missing ones.` : `Creates all ${PLAY_ORDER.length} matches with TBD teams. Winners and losers move into the next matches by themselves as results come in.`}
        </p>
        <form method="post" class="form bracket-form" aria-labelledby="bracket-h"><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
          <input type="hidden" name="intent" value="bracket" />
          <div class="form-grid">
            <ChoiceGroup name="groupBestOf" legend="Group matches" value={String(bracketCfg?.groupBestOf ?? 3)} options={[{ value: "1", label: "Bo1" }, { value: "3", label: "Bo3" }, { value: "5", label: "Bo5" }]} />
            <ChoiceGroup name="qfBestOf" legend="Quarter-finals" value={String(bracketCfg?.qfBestOf ?? 3)} options={[{ value: "1", label: "Bo1" }, { value: "3", label: "Bo3" }, { value: "5", label: "Bo5" }]} />
            <ChoiceGroup name="sfBestOf" legend="Semi-finals" value={String(bracketCfg?.sfBestOf ?? 3)} options={[{ value: "1", label: "Bo1" }, { value: "3", label: "Bo3" }, { value: "5", label: "Bo5" }]} />
            <ChoiceGroup name="gfBestOf" legend="Grand final" value={String(bracketCfg?.gfBestOf ?? 5)} options={[{ value: "1", label: "Bo1" }, { value: "3", label: "Bo3" }, { value: "5", label: "Bo5" }]} />
            <div class="field"><label for="dayStart">First match of the day</label><input id="dayStart" name="dayStart" type="time" required value="10:00" /></div>
            <div class="field"><label for="perDay">Matches per day</label><input id="perDay" name="perDay" type="number" min="1" max="12" required value="8" /></div>
            <div class="field"><label for="gap">Minutes between matches</label><input id="gap" name="gap" type="number" min="30" max="600" step="15" required value="90" aria-describedby="gap-hint" /><span id="gap-hint" class="hint">Each start time can be changed on the match afterwards.</span></div>
          </div>
          <details class="seeding">
            <summary>Seed the groups (optional)</summary>
            <p class="hint">Teams play the upper quarter-final next to them. Leave empty for TBD; teams can also be set on each match later.</p>
            <div class="seed-groups">
              {["A", "B"].map((g) => (
                <fieldset class="seed-group">
                  <legend>Group {g}</legend>
                  <ol class="seed-pairs">
                    {[1, 3, 5, 7].map((i) => (
                      <li>
                        <span class="pair-label">Upper QF {(i + 1) / 2}</span>
                        {[i, i + 1].map((n) => (
                          <select name={`seed_${g}${n}`} aria-label={`Group ${g}, seed ${n}`}>
                            <option value="">TBD</option>
                            {teams.map((t) => <option value={t.slug}>{t.name}</option>)}
                          </select>
                        ))}
                      </li>
                    ))}
                  </ol>
                </fieldset>
              ))}
            </div>
          </details>
          <div class="actions"><button type="submit" class="btn">{slotted ? "Add the missing matches" : "Create bracket matches"}</button></div>
        </form>
      </section>
    )
  }
</Admin>

<style>
  @layer components {
    .format-sum {
      display: grid;
      gap: var(--sp-02);
      margin: 0;
      padding: 0;
      list-style: none;
      & li {
        display: grid;
        grid-template-columns: 9rem minmax(0, 1fr);
        gap: var(--sp-04);
      }
      & strong {
        font-weight: 600;
      }
    }
    .bracket-form {
      max-inline-size: none;
    }
    .seeding > summary {
      cursor: pointer;
      color: var(--link);
    }
    .seed-groups {
      display: grid;
      gap: var(--sp-05);
      margin-block-start: var(--sp-03);
      @container page (width >= 56rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .seed-pairs {
      display: grid;
      gap: var(--sp-03);
      margin: 0;
      padding: 0;
      list-style: none;
      & li {
        display: grid;
        grid-template-columns: 6rem minmax(0, 1fr) minmax(0, 1fr);
        align-items: center;
        gap: var(--sp-03);
      }
    }
    .pair-label {
      color: var(--text-secondary);
      font-size: var(--type-label);
    }
    .editor {
      display: grid;
      gap: var(--sp-04);
      align-items: start;
      grid-template-columns: minmax(0, 1fr);
      @container page (width >= 64rem) {
        grid-template-columns: minmax(0, 1fr) 18rem;
      }
    }
    .editor-main {
      max-inline-size: none;
      padding: var(--sp-04);
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
    }
    .editor-side {
      display: grid;
      gap: var(--sp-04);
    }
    .side-card {
      display: grid;
      gap: var(--sp-04);
      padding: var(--sp-04);
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
    }
    .side-h {
      font-size: var(--type-body);
    }
    .check {
      display: flex;
      gap: var(--sp-03);
      align-items: center;
    }
    .prize-table td {
      padding-block: var(--sp-02);
    }
    .numbers {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin: 0;
      & dt {
        font-size: var(--type-label);
        color: var(--text-secondary);
      }
      & dd {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--type-heading-sm);
      }
    }
  }
</style>

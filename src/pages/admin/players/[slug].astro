---
import Admin from "../../../layouts/Admin.astro";
import ConfirmDelete from "../../../components/admin/ConfirmDelete.astro";
import CountrySelect from "../../../components/admin/CountrySelect.astro";
import Photo from "../../../components/Photo.astro";
import TransferRow from "../../../components/TransferRow.astro";
import { findPlayer, getTeams, playerElo, playerSummary, transfersFor } from "../../../data";
import { handlePost } from "../../../server/handle";
import { PLAYER_STATUSES, ROLES, deletePlayer, deleteTransfer, savePlayer } from "../../../server/mutations";
import { removeUpload, saveUpload } from "../../../server/uploads";
import { Temporal } from "temporal-polyfill";

const slug = Astro.params.slug ?? "";
const isNew = slug === "new";

const result = await handlePost(Astro.request, async (form, intent) => {
  if (intent === "delete") {
    deletePlayer(slug);
    return { redirect: "/admin/players/", message: "Player deleted" };
  }
  if (intent === "delete-transfer") {
    deleteTransfer(String(form.get("id") ?? ""));
    return { message: "Move removed from the history" };
  }
  const old = isNew ? undefined : findPlayer(slug)?.photo;
  const uploaded = await saveUpload(form, "photo", "Photo");
  const photo = form.get("removePhoto") ? null : uploaded;
  const p = savePlayer(isNew ? undefined : slug, form, photo);
  if (old && (photo === null || uploaded)) await removeUpload(old);
  return { redirect: `/admin/players/${p.slug}/`, message: isNew ? "Player added" : "Player saved" };
});
if (result instanceof Response) return result;

const p = isNew ? undefined : findPlayer(slug);
if (!isNew && !p) return Astro.rewrite("/404");
const teams = getTeams().toSorted((a, b) => a.name.localeCompare(b.name));
const presetTeam = p?.team ?? Astro.url.searchParams.get("team") ?? "";
const status = p?.status ?? (presetTeam ? "active" : "free");
const elo = p ? playerElo(p.slug) : undefined;
const summary = p ? playerSummary(p.slug) : undefined;
const history = p ? transfersFor(p.slug) : [];
const today = Temporal.Now.plainDateISO().toString();
const LABEL = { active: "Active (starting five)", benched: "Benched", free: "Free agent", retired: "Retired" } as const;
---

<Admin title={p ? p.nickname : "New player"} error={result?.error}>
  <a slot="actions" class="btn ghost" href="/admin/players/">All players</a>
  {p && <a slot="actions" class="btn ghost" href={`/players/${p.slug}/`} target="_blank" rel="noopener">View profile</a>}

  <div class="editor">
    <form method="post" class="form editor-main" enctype="multipart/form-data" id="player-form">
      <input type="hidden" name="intent" value="save" />

      <fieldset>
        <legend>Profile</legend>
        <div class="form-grid">
          <div class="field"><label for="nickname">Nickname</label><input id="nickname" name="nickname" required maxlength="32" autocomplete="off" value={p?.nickname ?? ""} /></div>
          <div class="field"><label for="firstName">First name</label><input id="firstName" name="firstName" maxlength="40" autocomplete="off" value={p?.firstName ?? ""} /></div>
          <div class="field"><label for="lastName">Last name</label><input id="lastName" name="lastName" maxlength="40" autocomplete="off" value={p?.lastName ?? ""} /></div>
          <div class="field"><label for="countryCode">Country</label><CountrySelect id="countryCode" value={p?.countryCode} /></div>
          <div class="field"><label for="age">Age</label><input id="age" name="age" type="number" min="10" max="60" inputmode="numeric" value={p?.age || ""} /></div>
          <div class="field">
            <label for="role">Role</label>
            <select id="role" name="role">{ROLES.map((r) => <option selected={(p?.role ?? "Rifler") === r}>{r}</option>)}</select>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>Team and status</legend>
        <div class="form-grid">
          <div class="field">
            <label for="team">Team</label>
            <select id="team" name="team">
              <option value="">No team</option>
              {teams.map((t) => <option value={t.slug} selected={presetTeam === t.slug}>{t.name}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status">{PLAYER_STATUSES.map((s) => <option value={s} selected={status === s}>{LABEL[s]}</option>)}</select>
          </div>
          <div class="field">
            <label for="moveDate">Move date</label>
            <input id="moveDate" name="moveDate" type="date" value={today} aria-describedby="move-hint" />
          </div>
          <div class="field"><label for="moveNote">Move note (optional)</label><input id="moveNote" name="moveNote" maxlength="120" placeholder="e.g. Loan until March" /></div>
        </div>
        <p id="move-hint" class="hint">Changing the team or status records a move in the history and on the home page's transfer list. Free agents and retired players have no team.</p>
      </fieldset>

      <fieldset>
        <legend>Game server</legend>
        <div class="form-grid">
          <div class="field"><label for="ign">In-game name (if different)</label><input id="ign" name="ign" maxlength="64" autocomplete="off" spellcheck="false" value={p?.ign ?? ""} /></div>
          <div class="field"><label for="steamId">Steam ID</label><input id="steamId" name="steamId" maxlength="32" autocomplete="off" spellcheck="false" inputmode="numeric" placeholder="7656… or [U:1:…]" value={p?.steamId ?? ""} /></div>
          <div class="field"><label for="joined">On team since</label><input id="joined" name="joined" type="date" value={p?.joined ?? ""} aria-describedby="joined-hint" /><span id="joined-hint" class="hint">Left empty, it follows the latest move.</span></div>
        </div>
      </fieldset>

      <div class="actions">
        <button type="submit" class="btn">{isNew ? "Add player" : "Save player"}</button>
      </div>
    </form>

    <aside class="editor-side" aria-label="Photo and history">
      <div class="side-card">
        <div class="portrait"><Photo player={p ?? ({ slug: "new", nickname: "", firstName: "", lastName: "", team: "", role: "Rifler", countryCode: "", age: 0 } as const)} size="card" /></div>
        <div class="field">
          <label for="photo">Photo (portrait 4:5, PNG/JPEG/WebP, up to 5 MB)</label>
          <input id="photo" name="photo" type="file" accept="image/png,image/jpeg,image/webp" form="player-form" />
        </div>
        {p?.photo && <label class="check"><input type="checkbox" name="removePhoto" form="player-form" /> Remove the current photo</label>}
      </div>

      {
        p && (
          <dl class="side-card numbers">
            <div><dt>Elo</dt><dd>{elo?.elo ?? "—"}</dd></div>
            <div><dt>Peak</dt><dd>{elo?.peak ?? "—"}</dd></div>
            <div><dt>Maps</dt><dd>{summary?.maps ?? 0}</dd></div>
            <div><dt>Rating</dt><dd>{summary?.maps ? summary.rating.toFixed(2) : "—"}</dd></div>
          </dl>
        )
      }

      {
        p && (
          <div class="side-card">
            <h2 class="side-h">Move history</h2>
            {history.length ? <ol class="moves">{history.map((t) => <TransferRow transfer={t} deletable />)}</ol> : <p class="muted">No moves recorded.</p>}
          </div>
        )
      }

      {p && <ConfirmDelete id="delete-player" what={p.nickname} action={`/admin/players/${p.slug}/`} label="Delete player" />}
    </aside>
  </div>
</Admin>

<style>
  @layer components {
    .editor {
      display: grid;
      gap: var(--sp-05);
      align-items: start;
      grid-template-columns: minmax(0, 1fr);
      @container page (width >= 64rem) {
        grid-template-columns: minmax(0, 1fr) 20rem;
      }
    }
    .editor-main {
      max-inline-size: none;
      padding: var(--sp-05);
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
    }
    .editor-side {
      display: grid;
      gap: var(--sp-05);
    }
    .side-card {
      display: grid;
      gap: var(--sp-04);
      padding: var(--sp-05);
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
    }
    .portrait {
      inline-size: 9rem;
      justify-self: center;
    }
    .check {
      display: flex;
      gap: var(--sp-03);
      align-items: center;
    }
    .numbers {
      grid-template-columns: repeat(2, 1fr);
      margin: 0;
      & div {
        display: grid;
        gap: var(--sp-01);
      }
      & dt {
        font-size: var(--type-label);
        color: var(--text-secondary);
      }
      & dd {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--type-heading-sm);
      }
    }
    .side-h {
      font-size: var(--type-body);
    }
    .moves {
      display: grid;
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }
</style>

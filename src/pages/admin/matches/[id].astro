---
import Admin from "../../../layouts/Admin.astro";
import Icon from "../../../components/Icon.astro";
import LiveRegion from "../../../components/LiveRegion.astro";
import ConfirmDelete from "../../../components/admin/ConfirmDelete.astro";
import MatchControl from "../../../components/admin/MatchControl.astro";
import MatchMetaFields from "../../../components/admin/MatchMetaFields.astro";
import { event, findMatch, matchRoster, team, teamAt } from "../../../data";
import { handlePost } from "../../../server/handle";
import { MAP_POOL, deleteMatch, updateMatch } from "../../../server/mutations";
import { createFeed, feedFor, revokeFeed } from "../../../server/ingest";
import LocalTime from "../../../components/LocalTime.astro";
import { aiReady } from "../../../server/ai/config";
import { discardDraft, getDraft, readScoreboard } from "../../../server/ai/ocr";
import { FormError } from "../../../server/forms";

const id = Astro.params.id ?? "";

const result = await handlePost(Astro.request, async (form, intent) => {
  if (intent === "ocr") {
    const m = findMatch(id);
    if (!m) throw new FormError("This match no longer exists.");
    const file = form.get("screenshot");
    if (!(file instanceof File)) throw new FormError("Choose a screenshot to read.", "screenshot");
    const d = await readScoreboard(m, Number(form.get("ocrMap") ?? 0), file);
    const n = Object.keys(d.stats).length;
    return { redirect: `/admin/matches/${id}/?draft=${d.id}#ocr-h`, message: `Read ${n} ${n === 1 ? "player" : "players"} from the screenshot. Check the numbers, then save.` };
  }
  if (intent === "ocr-discard") {
    discardDraft(String(form.get("draft") ?? ""));
    return { redirect: `/admin/matches/${id}/`, message: "Screenshot reading discarded" };
  }
  if (intent === "ocr-apply") {
    // One review form saves the map score, then the stats, with the usual validation.
    const hasScore = String(form.get("scoreA") ?? "") !== "" || String(form.get("scoreB") ?? "") !== "";
    if (hasScore) updateMatch(id, "map", form);
    updateMatch(id, "stats", form);
    discardDraft(String(form.get("draft") ?? ""));
    return { redirect: `/admin/matches/${id}/#stats-h`, message: "Scoreboard saved to the match" };
  }
  if (intent === "delete") {
    deleteMatch(id);
    revokeFeed(id);
    return { redirect: "/admin/matches/", message: "Match deleted" };
  }
  if (intent === "feed-create") {
    createFeed(id);
    return { message: "Server feed key created" };
  }
  if (intent === "feed-revoke") {
    revokeFeed(id);
    return { message: "Server feed disconnected" };
  }
  updateMatch(id, intent, form);
  return {
    message:
      { meta: "Details saved", status: "Status updated", round: "Score updated", map: "Map saved", stats: "Stats saved", veto: "Veto saved" }[intent] ??
      "Saved",
  };
});
if (result instanceof Response) return result;

const m = findMatch(id);
if (!m) return Astro.rewrite("/404");
const a = team(m.teamA);
const b = team(m.teamB);
const action = `/admin/matches/${m.id}/`;
const pickValue = (slug?: string) => (slug === m.teamA ? "A" : slug === m.teamB ? "B" : "");
const deps = [`match:${m.id}`];
const ai = aiReady();
const draft = getDraft(Astro.url.searchParams.get("draft"), m.id);
const draftMap = draft ? m.maps[draft.mapIndex] : undefined;
const feed = feedFor(m.id);
const origin = Astro.url.origin;
const cs2Commands = feed
  ? [
      `mp_teamname_1 "${a.name}"`,
      `mp_teamname_2 "${b.name}"`,
      "mp_logdetail 3",
      "log on",
      `logaddress_add_http "${origin}/api/ingest/cs2/${feed.key}"`,
    ].join("\n")
  : "";
const gsiConfig = feed
  ? `"ISEC"
{
  "uri" "${origin}/api/ingest/gsi/${feed.key}"
  "timeout" "5.0"
  "buffer" "0.1"
  "throttle" "0.5"
  "heartbeat" "10.0"
  "data"
  {
    "provider" "1"
    "map" "1"
    "round" "1"
    "allplayers_id" "1"
    "allplayers_match_stats" "1"
  }
}`
  : "";
---

<Admin title={`${a.name} vs ${b.name}`} error={result?.error}>
  <a slot="actions" class="btn ghost" href="/admin/matches/">All matches</a>
  <a slot="actions" class="btn ghost" href={`/matches/${m.id}/`} target="_blank" rel="noopener">Public page <Icon name="arrow" size={14} /></a>
  <p class="muted match-sub">{event(m.event).name} · {m.stage} · Best of {m.bestOf}</p>
  <nav class="segmented jump" aria-label="Match sections">
    <a href="#live-h">Score</a>
    <a href="#maps-h">Maps</a>
    <a href="#ocr-h">Scoreboard</a>
    <a href="#stats-h">Player stats</a>
    <a href="#veto-h">Veto</a>
    <a href="#feed-h">Game server</a>
    <a href="#details-h">Details</a>
  </nav>

  <section class="admin-section" aria-labelledby="live-h">
    <h2 id="live-h">Live control</h2>
    <LiveRegion key="control" deps={deps}>
      <MatchControl match={m} embedded />
    </LiveRegion>
  </section>

  <section class="admin-section" aria-labelledby="maps-h">
    <h2 id="maps-h">Maps</h2>
    <p class="muted">Leave both scores empty for a map that hasn't been played. The series score is calculated from finished maps.</p>
    <LiveRegion key="maps" deps={deps}>
      <div class="maps-forms">
        {
          m.maps.map((map, i) => (
            <form method="post" action={action} class="form" aria-label={`Map ${i + 1}`}><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
              <input type="hidden" name="intent" value="map" />
              <input type="hidden" name="map" value={i} />
              <fieldset>
                <legend>Map {i + 1}{map.live ? " — live" : ""}</legend>
                <div class="form-grid">
                  <div class="field">
                    <label for={`mapName-${i}`}>Map</label>
                    <select id={`mapName-${i}`} name="mapName">
                      {MAP_POOL.map((p) => <option selected={map.map === p}>{p}</option>)}
                    </select>
                  </div>
                  <div class="field">
                    <label for={`pickedBy-${i}`}>Picked by</label>
                    <select id={`pickedBy-${i}`} name="pickedBy">
                      <option value="" selected={!map.pickedBy}>Decider</option>
                      <option value="A" selected={pickValue(map.pickedBy) === "A"}>{a.name}</option>
                      <option value="B" selected={pickValue(map.pickedBy) === "B"}>{b.name}</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for={`scoreA-${i}`}>{a.name} rounds</label>
                    <input id={`scoreA-${i}`} name="scoreA" type="number" min="0" max="99" inputmode="numeric" value={map.scoreA ?? ""} />
                  </div>
                  <div class="field">
                    <label for={`scoreB-${i}`}>{b.name} rounds</label>
                    <input id={`scoreB-${i}`} name="scoreB" type="number" min="0" max="99" inputmode="numeric" value={map.scoreB ?? ""} />
                  </div>
                  <div class="field">
                    <label for={`side-${i}`}>{a.name} started on</label>
                    <select id={`side-${i}`} name="startSideA">
                      <option value="" selected={!map.startSideA}>Unknown</option>
                      <option value="CT" selected={map.startSideA === "CT"}>CT</option>
                      <option value="T" selected={map.startSideA === "T"}>T</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for={`halfA-${i}`}>{a.name} first half</label>
                    <input id={`halfA-${i}`} name="halfA" type="number" min="0" max="12" inputmode="numeric" value={map.halfA?.[0] ?? ""} />
                  </div>
                  <div class="field">
                    <label for={`halfB-${i}`}>{b.name} first half</label>
                    <input id={`halfB-${i}`} name="halfB" type="number" min="0" max="12" inputmode="numeric" value={map.halfB?.[0] ?? ""} />
                  </div>
                </div>
                <div class="checks">
                  <label><input type="checkbox" name="live" checked={map.live} /> This map is live</label>
                </div>
                <div class="actions"><button type="submit" class="btn small">Save map {i + 1}</button></div>
              </fieldset>
            </form>
          ))
        }
      </div>
    </LiveRegion>
  </section>

  <section class="admin-section ocr" aria-labelledby="ocr-h">
    <div class="section-head">
      <h2 id="ocr-h">Read a scoreboard screenshot</h2>
      {!ai && <a href="/admin/assistant/settings/">Set up an AI provider</a>}
    </div>
    {
      !ai ? (
        <p class="muted">Upload an end-of-map scoreboard (CS2, Perfect World, FACEIT, 5E…) and the AI fills in the map score and every player's K/D/A, ADR, HS% and rating for you to check. Connect an AI provider first.</p>
      ) : draft && draftMap ? (
        <form method="post" action={action} class="form ocr-review" aria-labelledby="ocr-h"><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
          <input type="hidden" name="draft" value={draft.id} />
          <input type="hidden" name="map" value={draft.mapIndex} />
          <input type="hidden" name="pickedBy" value={pickValue(draftMap.pickedBy)} />
          {draftMap.startSideA && <input type="hidden" name="startSideA" value={draftMap.startSideA} />}
          <p class="notice">Read from your screenshot for <strong>map {draft.mapIndex + 1}</strong>. Check every number against the image, fix anything wrong, then save. Nothing is saved yet.</p>
          {draft.unmatched.length > 0 && <p class="notice">Not on either roster, so left out: {draft.unmatched.join(", ")}. Add their in-game name to the player profile to match them next time.</p>}
          <div class="form-grid">
            <div class="field">
              <label for="ocr-mapName">Map</label>
              <select id="ocr-mapName" name="mapName">{MAP_POOL.map((p) => <option selected={(draft.map ?? draftMap.map) === p}>{p}</option>)}</select>
            </div>
            <div class="field"><label for="ocr-scoreA">{a.name} rounds</label><input id="ocr-scoreA" name="scoreA" type="number" min="0" max="99" inputmode="numeric" value={draft.scoreA ?? draftMap.scoreA ?? ""} /></div>
            <div class="field"><label for="ocr-scoreB">{b.name} rounds</label><input id="ocr-scoreB" name="scoreB" type="number" min="0" max="99" inputmode="numeric" value={draft.scoreB ?? draftMap.scoreB ?? ""} /></div>
          </div>
          <div class="table-wrap" role="region" aria-label="Stats read from the screenshot" tabindex="0">
            <table class="data-table stats-input">
              <thead><tr><th scope="col">Player</th>{["K", "D", "A", "ADR", "KAST %", "HS %", "Rating"].map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>
                {matchRoster(m).map((p) => {
                  const s = draft.stats[p.slug];
                  const cells: [string, number | undefined, string][] = [["k", s?.kills, "1"], ["d", s?.deaths, "1"], ["a", s?.assists, "1"], ["adr", s?.adr, "0.1"], ["kast", s?.kast, "0.1"], ["hs", s?.hs, "0.1"], ["rating", s?.rating, "0.01"]];
                  return (
                    <tr class:list={{ missing: !s }}>
                      <th scope="row">{p.nickname} <span class="subtle">{team(teamAt(p.slug, m.start.slice(0, 10)) || p.team).tag}</span>{!s && <span class="subtle"> · not found</span>}</th>
                      {cells.map(([key, value, step]) => (
                        <td><input name={`${key}_${p.slug}`} type="number" min="0" step={step} inputmode="decimal" value={value ?? ""} aria-label={`${p.nickname} ${key.toUpperCase()}`} /></td>
                      ))}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <div class="actions">
            <button type="submit" class="btn" name="intent" value="ocr-apply">Save to map {draft.mapIndex + 1}</button>
            <button type="submit" class="btn ghost" name="intent" value="ocr-discard" formnovalidate>Discard</button>
          </div>
        </form>
      ) : (
        <form method="post" action={action} class="form ocr-upload" enctype="multipart/form-data" aria-labelledby="ocr-h" data-busy="Reading the screenshot…"><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
          <input type="hidden" name="intent" value="ocr" />
          <p class="muted">Upload an end-of-map scoreboard (CS2, Perfect World, FACEIT, 5E…). The AI reads the score and every player's numbers; you check them before anything is saved.</p>
          <div class="form-grid">
            <div class="field">
              <label for="ocrMap">Map</label>
              <select id="ocrMap" name="ocrMap">{m.maps.map((x, i) => <option value={i} selected={x.live}>Map {i + 1} — {x.map}{x.scoreA !== undefined ? ` (${x.scoreA}–${x.scoreB})` : ""}</option>)}</select>
            </div>
            <div class="field">
              <label for="screenshot">Screenshot (PNG, JPEG or WebP, up to 8 MB)</label>
              <input id="screenshot" name="screenshot" type="file" accept="image/png,image/jpeg,image/webp" required />
            </div>
          </div>
          <div class="actions"><button type="submit" class="btn">Read screenshot</button></div>
        </form>
      )
    }
  </section>

  <section class="admin-section" aria-labelledby="stats-h">
    <h2 id="stats-h">Player stats</h2>
    <p class="muted">Kills and deaths are required for a player to appear. Leave ADR, KAST or rating empty to estimate them.</p>
    {
      m.maps.map((map, i) =>
        map.scoreA === undefined ? null : (
          <form method="post" action={action} class="form stats-form" aria-label={`Stats for map ${i + 1}`}><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
            <input type="hidden" name="intent" value="stats" />
            <input type="hidden" name="map" value={i} />
            <fieldset>
              <legend>Map {i + 1} — {map.map} ({map.scoreA}–{map.scoreB})</legend>
              <div class="table-wrap" role="region" aria-label={`Stats inputs, map ${i + 1}`} tabindex="0">
                <table class="data-table stats-input">
                  <thead>
                    <tr>
                      <th scope="col">Player</th>
                      {["K", "D", "A", "ADR", "KAST %", "HS %", "Rating", "RWS", "First K", "First D", "Clutch W", "Clutch P", "Util dmg", "Flash ast"].map((h) => <th scope="col">{h}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {matchRoster(m).map((p) => {
                      const s = map.stats?.find((x) => x.player === p.slug);
                      const cells: [string, number | undefined, string][] = [
                        ["k", s?.kills, "1"], ["d", s?.deaths, "1"], ["a", s?.assists, "1"],
                        ["adr", s?.adr, "0.1"], ["kast", s?.kast, "0.1"], ["hs", s?.hs, "0.1"], ["rating", s?.rating, "0.01"],
                        ["rws", s?.rws, "0.01"], ["fk", s?.firstKills, "1"], ["fd", s?.firstDeaths, "1"], ["cw", s?.clutchesWon, "1"],
                        ["cp", s?.clutchesPlayed, "1"], ["ud", s?.utilityDamage, "1"], ["fa", s?.flashAssists, "1"],
                      ];
                      return (
                        <tr>
                          <th scope="row">{p.nickname} <span class="subtle">{team(teamAt(p.slug, m.start.slice(0, 10)) || p.team).tag}</span></th>
                          {cells.map(([key, value, step]) => (
                            <td>
                              <input
                                name={`${key}_${p.slug}`}
                                type="number"
                                min="0"
                                step={step}
                                inputmode="decimal"
                                value={value ?? ""}
                                aria-label={`${p.nickname} ${key.toUpperCase()}`}
                              />
                            </td>
                          ))}
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              <details>
                <summary>Paste a Perfect World / CSV export instead</summary>
                <div class="field">
                  <label for={`csv-${i}`}>One header row, then one row per player</label>
                  <textarea id={`csv-${i}`} name="csv" rows="6" spellcheck="false" aria-describedby={`csv-hint-${i}`} placeholder="player,kills,deaths,assists,adr,rws,rating,kast,hs,fk,fd,cw,cp,ud,fa"></textarea>
                  <span id={`csv-hint-${i}`} class="hint">Comma, tab or semicolon separated. Players are matched by nickname, in-game name or Steam ID; pasted values replace the table.</span>
                </div>
              </details>
              <div class="actions"><button type="submit" class="btn small">Save stats for map {i + 1}</button></div>
            </fieldset>
          </form>
        ),
      )
    }
    {m.maps.every((x) => x.scoreA === undefined) && <p class="empty">Stats can be entered once a map has a score.</p>}
  </section>

  <section class="admin-section" aria-labelledby="veto-h">
    <h2 id="veto-h">Map veto</h2>
    <form method="post" action={action} class="form" aria-labelledby="veto-h"><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
      <input type="hidden" name="intent" value="veto" />
      <div class="table-wrap" role="region" aria-label="Veto steps" tabindex="0">
        <table class="data-table">
          <thead><tr><th scope="col">#</th><th scope="col">Team</th><th scope="col">Action</th><th scope="col">Map</th></tr></thead>
          <tbody>
            {
              Array.from({ length: 7 }, (_, i) => {
                const v = m.veto[i];
                return (
                  <tr>
                    <th scope="row">{i + 1}</th>
                    <td>
                      <select name={`veto_team_${i}`} aria-label={`Step ${i + 1} team`}>
                        <option value="" selected={!v?.team}>—</option>
                        <option value="A" selected={pickValue(v?.team) === "A"}>{a.name}</option>
                        <option value="B" selected={pickValue(v?.team) === "B"}>{b.name}</option>
                      </select>
                    </td>
                    <td>
                      <select name={`veto_action_${i}`} aria-label={`Step ${i + 1} action`}>
                        {(["removed", "picked", "left over"] as const).map((x) => <option selected={(v?.action ?? (i === 6 ? "left over" : "removed")) === x}>{x}</option>)}
                      </select>
                    </td>
                    <td>
                      <select name={`veto_map_${i}`} aria-label={`Step ${i + 1} map`}>
                        <option value="" selected={!v}>—</option>
                        {MAP_POOL.map((p) => <option selected={v?.map === p}>{p}</option>)}
                      </select>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <div class="actions"><button type="submit" class="btn small">Save veto</button></div>
    </form>
  </section>

  <section class="admin-section" aria-labelledby="feed-h">
    <h2 id="feed-h">Game server feed</h2>
    <LiveRegion key="feed" deps={[...deps, "feed:*"]}>
      {
        feed ? (
          <p class="feed-status">
            {m.feed?.lastSeenAt ? (
              <>
                <span class="badge green">Connected</span> Last data <LocalTime instant={m.feed.lastSeenAt} zone="UTC" format="datetime" /> via{" "}
                {m.feed.source === "gsi" ? "Game State Integration" : "server log"}.
              </>
            ) : (
              <>
                <span class="badge blue">Waiting</span> No data received yet. Run the commands below on the match server.
              </>
            )}
          </p>
        ) : (
          <p class="muted">Connect the tournament server and scores, round history, the kill log and player stats update here and on the site automatically.</p>
        )
      }
      {m.feed?.unmatched?.length ? (
        <p class="notice error">
          Players on the server not matched to a roster: {m.feed.unmatched.join(", ")}. Set their in-game name or Steam ID under Teams & players.
        </p>
      ) : null}
    </LiveRegion>
    {
      feed && (
        <div class="feed-config">
          <div class="field">
            <div class="copy-row">
              <label for="cmd-cs2">Server console (or match cfg)</label>
              <span class="copy">
                <button type="button" class="btn ghost small" command="--copy" commandfor="cmd-cs2">Copy commands</button>
                <span class="tip" role="status" />
              </span>
            </div>
            <textarea id="cmd-cs2" readonly rows="5" spellcheck="false">{cs2Commands}</textarea>
          </div>
          <details>
            <summary>Observer PC instead: Game State Integration file</summary>
            <div class="field">
              <div class="copy-row">
                <label for="cmd-gsi">Save as <code>game/csgo/cfg/gamestate_integration_isec.cfg</code></label>
                <span class="copy">
                  <button type="button" class="btn ghost small" command="--copy" commandfor="cmd-gsi">Copy file</button>
                  <span class="tip" role="status" />
                </span>
              </div>
              <textarea id="cmd-gsi" readonly rows="16" spellcheck="false">{gsiConfig}</textarea>
            </div>
          </details>
        </div>
      )
    }
    <form method="post" action={action} class="actions"><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
      <button type="submit" class="btn small" name="intent" value="feed-create">{feed ? "Generate a new key" : "Connect a server"}</button>
      {feed && <button type="submit" class="btn ghost small" name="intent" value="feed-revoke">Disconnect</button>}
    </form>
  </section>

  <section class="admin-section" aria-labelledby="details-h">
    <h2 id="details-h">Details</h2>
    <form method="post" action={action} class="form" aria-labelledby="details-h"><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
      <input type="hidden" name="intent" value="meta" />
      <MatchMetaFields match={m} />
      <div class="actions"><button type="submit" class="btn">Save details</button></div>
    </form>
  </section>

  <section class="admin-section" aria-labelledby="danger-h">
    <h2 id="danger-h">Delete</h2>
    <div class="actions"><ConfirmDelete id="delete-match" what="this match" action={action} label="Delete match" /></div>
  </section>
</Admin>

<style>
  .match-sub {
    margin-block-start: calc(var(--sp-05) * -1);
  }
  .jump {
    position: sticky;
    inset-block-start: calc(var(--header-height) + var(--sp-02));
    z-index: 2;
    background: var(--surface);
  }
  :global(.admin-section h2) {
    scroll-margin-block-start: calc(var(--header-height) + 4rem);
  }
  @layer components {
    .ocr-review .missing th {
      color: var(--text-secondary);
    }
    .ocr-review .notice {
      margin: 0;
    }
    .maps-forms {
      display: grid;
      gap: var(--sp-05);
    }
    .feed-status {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-03);
    }
    .feed-config {
      display: grid;
      gap: var(--sp-05);
      max-inline-size: 60rem;
      & textarea {
        font-family: var(--font-mono);
        font-size: var(--type-body-sm);
        min-block-size: auto;
      }
      & summary {
        cursor: pointer;
        color: var(--link);
      }
    }
    .copy-row {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      justify-content: space-between;
      gap: var(--sp-03);
    }
    .copy {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-03);
    }
    .tip {
      font-size: var(--type-label);
      color: var(--support-success);
      opacity: 0;
      transition: opacity var(--duration-fast);
    }
    .tip:not(:empty) {
      opacity: 1;
    }
    .stats-input input {
      min-inline-size: 4.5rem;
      min-block-size: 2.25rem;
      padding: var(--sp-02) var(--sp-03);
    }
    .stats-input td {
      padding: var(--sp-02);
    }
  }
</style>
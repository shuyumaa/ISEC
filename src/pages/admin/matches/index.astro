---
import Admin from "../../../layouts/Admin.astro";
import LiveRegion from "../../../components/LiveRegion.astro";
import LocalTime from "../../../components/LocalTime.astro";
import MatchMetaFields from "../../../components/admin/MatchMetaFields.astro";
import { event, getEvents, getMatches, getTeams, matchInstant, matchStart, team } from "../../../data";
import { handlePost } from "../../../server/handle";
import { createMatch } from "../../../server/mutations";

const result = await handlePost(Astro.request, (form) => {
  const m = createMatch(form);
  return { redirect: `/admin/matches/${m.id}/`, message: "Match created" };
});
if (result instanceof Response) return result;

const filter = Astro.url.searchParams.get("status") ?? "all";
const order = { live: 0, upcoming: 1, completed: 2 } as const;
const all = getMatches();
const counts = { all: all.length, live: 0, upcoming: 0, completed: 0 };
for (const m of all) counts[m.status] += 1;
const list = all
  .filter((m) => filter === "all" || m.status === filter)
  .toSorted((a, b) => order[a.status] - order[b.status] || matchStart(b).epochMilliseconds - matchStart(a).epochMilliseconds);
const openNew = Astro.url.searchParams.has("new") || Boolean(result?.error);
const canSchedule = getEvents().length > 0 && getTeams().length >= 2;
const filters = [["all", "All"], ["live", "Live"], ["upcoming", "Upcoming"], ["completed", "Completed"]] as const;
---

<Admin title="Matches" error={result?.error}>
  <a slot="actions" class="btn" href="?new=1#new">Schedule a match</a>

  <details class="admin-section" id="new" open={openNew}>
    <summary>Schedule a match</summary>
    {!canSchedule && <p class="notice">Before scheduling, <a href="/admin/events/new/">create an event</a> and <a href="/admin/teams/new/">add at least two teams</a>.</p>}
    <form method="post" class="form" hidden={!canSchedule}><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
      <MatchMetaFields presetEvent={Astro.url.searchParams.get("event") ?? undefined} />
      <div class="actions"><button type="submit" class="btn">Create match</button></div>
    </form>
  </details>

  <section class="admin-section">
    <div class="section-head">
      <h2 id="all-h">All matches</h2>
      <nav class="segmented" aria-label="Filter matches">
        {filters.map(([k, label]) => (
          <a href={k === "all" ? "?" : `?status=${k}`} aria-current={filter === k ? "page" : undefined}>
            {label} <span class="n">{counts[k]}</span>
          </a>
        ))}
      </nav>
    </div>
    <LiveRegion key="list" deps={["match:*"]}>
      <div class="table-wrap" role="region" aria-labelledby="all-h" tabindex="0">
        <table class="data-table">
          <thead>
            <tr><th scope="col">Match</th><th scope="col">Status</th><th scope="col" class="n">Score</th><th scope="col">Event</th><th scope="col">Start (your time)</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
          </thead>
          <tbody>
            {
              list.map((m) => (
                <tr>
                  <th scope="row"><a href={`/admin/matches/${m.id}/`}>{team(m.teamA).name} vs {team(m.teamB).name}</a></th>
                  <td><span class:list={["badge", { live: m.status === "live", blue: m.status === "upcoming" }]}>{m.status}</span></td>
                  <td class="n mono">{m.status === "upcoming" ? "–" : `${m.seriesA}–${m.seriesB}`}</td>
                  <td>{event(m.event).name} · {m.stage}</td>
                  <td><LocalTime instant={matchInstant(m)} zone={event(m.event).timeZone} format="datetime" /></td>
                  <td><a class="btn ghost small" href={`/admin/matches/${m.id}/`}>{m.status === "live" ? "Control" : m.status === "upcoming" ? "Edit" : "Stats"}</a></td>
                </tr>
              ))
            }
          </tbody>
        </table>
        {list.length === 0 && <p class="empty">No matches here.</p>}
      </div>
    </LiveRegion>
  </section>
</Admin>

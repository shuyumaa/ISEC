---
import Base from "../../layouts/Base.astro";
import LiveRegion from "../../components/LiveRegion.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EventMark from "../../components/EventMark.astro";
import Flag from "../../components/Flag.astro";
import MatchRow from "../../components/MatchRow.astro";
import Panel from "../../components/Panel.astro";
import StatsTable from "../../components/StatsTable.astro";
import SwissBracket from "../../components/SwissBracket.astro";
import TeamMark from "../../components/TeamMark.astro";
import {
  findEvent,
  formatRange,
  matchesForEvent,
  money,
  player,
  playerLeaderboard,
  playoffBracket,
  rankOf,
  swissBracket,
  team,
  winnerOf,
} from "../../data";

const ev = findEvent(Astro.params.slug ?? "");
if (!ev) return Astro.rewrite("/404");
const list = matchesForEvent(ev.slug);
const live = list.filter((m) => m.status === "live");
const upcoming = list.filter((m) => m.status === "upcoming");
const results = list.filter((m) => m.status === "completed").reverse();
const swiss = swissBracket(ev);
const playoffs = playoffBracket(ev);
const related = (ev.related ?? []).map((s) => findEvent(s)).filter((e) => e !== undefined);
const top = playerLeaderboard(1, (m) => m.event === ev.slug).slice(0, 10);

// How often each pool map was played at this event (decided maps only).
const mapPlays = new Map<string, number>();
for (const m of list) for (const x of m.maps) if (x.scoreA !== undefined && !x.live && (x.scoreA ?? 0) + (x.scoreB ?? 0) > 0) mapPlays.set(x.map, (mapPlays.get(x.map) ?? 0) + 1);
const pool = ev.mapPool?.length ? ev.mapPool : [...mapPlays.keys()];

const status = { ongoing: "Ongoing", upcoming: "Upcoming", completed: "Completed" }[ev.status];
const sections = [
  { id: "overview", label: "Overview" },
  { id: "matches", label: "Matches" },
  related.length > 0 && { id: "related", label: "Related events" },
  swiss && { id: "group-play", label: "Group play" },
  playoffs.length > 0 && { id: "playoffs", label: "Playoffs" },
  ev.prizes.length > 0 && { id: "prizes", label: "Prize distribution" },
  ev.teams.length > 0 && { id: "teams", label: "Teams attending" },
  ev.format.length > 0 && { id: "formats", label: "Formats" },
  pool.length > 0 && { id: "map-pool", label: "Map pool" },
  top.length > 0 && { id: "top-players", label: "Top players" },
].filter(Boolean) as { id: string; label: string }[];
---

<Base title={ev.name} leftRail={false} description={`${ev.name}: ${formatRange(ev.startDate, ev.endDate)}, ${ev.location}, ${money(ev.prizePool)} prize pool.`}>
  <Breadcrumbs items={[{ label: "Events", href: "/events/" }, { label: ev.name, href: `/events/${ev.slug}/` }]} />

  <LiveRegion key="event" deps={[`event:${ev.slug}`, "match:*", "team:*", "player:*"]}>
    <div class="event-layout">
      <nav class="sections" aria-label="Event sections">
        <p class="sections-h" aria-hidden="true">Sections</p>
        <ul>{sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ul>
      </nav>

      <div class="event-main">
        <header id="overview" class="hero">
          <div class="hero-top">
            <EventMark event={ev} size="lg" />
            <div class="hero-title">
              <div class="badges">
                <span class:list={["badge", { green: ev.status === "ongoing", blue: ev.status === "upcoming" }]}>{status}</span>
                <span class:list={["badge", { purple: ev.tier === "Major" }]}>{ev.tier}</span>
                {ev.online && <span class="badge">Online</span>}
              </div>
              <h1>{ev.name}</h1>
            </div>
          </div>
          <dl class="facts">
            <div><dt>Date</dt><dd>{formatRange(ev.startDate, ev.endDate)}</dd></div>
            <div><dt>Prize pool</dt><dd>{money(ev.prizePool)}</dd></div>
            <div><dt>Teams</dt><dd>{ev.teams.length}</dd></div>
            <div><dt>Location</dt><dd>{ev.location}</dd></div>
            {ev.winner && <div><dt>Winner</dt><dd><a class="inline-team" href={`/teams/${ev.winner}/`}><TeamMark team={team(ev.winner)} /> {team(ev.winner).name}</a></dd></div>}
            {ev.mvp && <div><dt>MVP</dt><dd><a href={`/players/${ev.mvp}/`}>{player(ev.mvp).nickname}</a></dd></div>}
          </dl>
        </header>

        {
          related.length > 0 && (
            <Panel title="Related events" id="related">
              <ul class="related">
                {related.map((r) => (
                  <li>
                    <a href={`/events/${r.slug}/`}>
                      <EventMark event={r} size="md" />
                      <span><strong>{r.name}</strong><span class="subtle">{formatRange(r.startDate, r.endDate)}</span></span>
                    </a>
                  </li>
                ))}
              </ul>
            </Panel>
          )
        }

        {
          swiss && (
            <section id="group-play" class="block" aria-labelledby="gp-h">
              <div class="block-head">
                <h2 id="gp-h">Group play</h2>
                <span class="subtle">Swiss · {swiss.rules.wins} wins to advance, {swiss.rules.losses} losses out</span>
              </div>
              <SwissBracket swiss={swiss} />
            </section>
          )
        }

        {
          playoffs.length > 0 && (
            <section id="playoffs" class="block" aria-labelledby="po-h">
              <div class="block-head"><h2 id="po-h">Playoffs</h2></div>
              <div class="bracket-wrap" role="region" aria-labelledby="po-h" tabindex="0">
                <ol class="bracket">
                  {playoffs.map((r) => (
                    <li class="round">
                      <h3 class="round-h">{r.name}</h3>
                      <ul class="round-matches">
                        {r.matches.map((m) => {
                          const w = winnerOf(m);
                          return (
                            <li>
                              <a class:list={["pm", m.status]} href={`/matches/${m.id}/`}>
                                {[m.teamA, m.teamB].map((slug, i) => (
                                  <span class:list={["pm-team", { won: w === slug, lost: w && w !== slug }]}>
                                    <TeamMark team={team(slug)} />
                                    <span class="pm-name">{team(slug).name}</span>
                                    <span class="pm-score">{m.status === "upcoming" ? "–" : i === 0 ? m.seriesA : m.seriesB}</span>
                                  </span>
                                ))}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          )
        }

        <section id="matches" class="stack" aria-label="Matches">
          {live.length > 0 && <Panel title="Live">{live.map((m) => <MatchRow match={m} hideEvent />)}</Panel>}
          {upcoming.length > 0 && <Panel title="Upcoming matches">{upcoming.map((m) => <MatchRow match={m} hideEvent showDate />)}</Panel>}
          {results.length > 0 && <Panel title="Results">{results.map((m) => <MatchRow match={m} hideEvent showDate />)}</Panel>}
          {list.length === 0 && <Panel title="Matches"><p class="empty">No matches scheduled yet.</p></Panel>}
        </section>

        {
          ev.prizes.length > 0 && (
            <Panel title="Prize distribution" id="prizes">
              <div class="table-wrap" role="region" aria-label="Prize distribution" tabindex="0">
                <table class="data-table">
                  <thead><tr><th scope="col">Place</th><th scope="col">Team</th><th scope="col" class="n">Prize</th></tr></thead>
                  <tbody>
                    {ev.prizes.map((p) => (
                      <tr>
                        <th scope="row">{p.place}</th>
                        <td>{p.team ? <a class="inline-team" href={`/teams/${p.team}/`}><TeamMark team={team(p.team)} /> {team(p.team).name}</a> : <span class="subtle">TBD</span>}</td>
                        <td class="n">{money(p.prize)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </Panel>
          )
        }

        {
          ev.teams.length > 0 && (
            <Panel title="Teams attending" id="teams">
              <ul class="team-grid">
                {ev.teams.map((slug) => {
                  const t = team(slug);
                  return (
                    <li>
                      <a href={`/teams/${t.slug}/`}>
                        <TeamMark team={t} size="md" />
                        <span>
                          <strong>{t.name}</strong>
                          <span class="subtle"><Flag code={t.countryCode} /> {rankOf(t.slug) ? `Rank #${rankOf(t.slug)}` : t.country}</span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </Panel>
          )
        }

        {
          ev.format.length > 0 && (
            <Panel title="Formats" id="formats">
              <ul class="format">{ev.format.map((f) => <li>{f}</li>)}</ul>
            </Panel>
          )
        }

        {
          pool.length > 0 && (
            <Panel title="Map pool" id="map-pool">
              <ul class="pool">
                {pool.map((name) => (
                  <li>
                    <span class="pool-name">{name}</span>
                    <span class="subtle">{mapPlays.get(name) ?? 0} {mapPlays.get(name) === 1 ? "time" : "times"} played</span>
                  </li>
                ))}
              </ul>
            </Panel>
          )
        }

        {
          top.length > 0 && (
            <Panel title="Top players" id="top-players">
              <StatsTable id={`top-${ev.slug}`} caption={`Top players at ${ev.name}`} hideCaption rows={top} showMaps />
            </Panel>
          )
        }
      </div>
    </div>
  </LiveRegion>
</Base>

<style>
  @layer components {
    .event-layout {
      display: grid;
      gap: var(--sp-05);
      grid-template-columns: minmax(0, 1fr);
      @container page (width >= 56rem) {
        grid-template-columns: 12rem minmax(0, 1fr);
      }
    }
    /* HLTV's left "Sections" list: in-page links, sticky while scrolling. */
    .sections {
      align-self: start;
      background: var(--surface);
      @container page (width >= 56rem) {
        position: sticky;
        inset-block-start: calc(var(--header-height) + var(--sp-04));
      }
      & ul {
        display: flex;
        flex-wrap: wrap;
        list-style: none;
        margin: 0;
        padding: 0;
        @container page (width >= 56rem) {
          display: grid;
        }
      }
      & a {
        display: block;
        padding: var(--sp-03) var(--sp-05);
        border-block-start: var(--border-width) solid var(--border-subtle);
        text-decoration: none;
        color: var(--text-primary);
        &:hover {
          background: var(--layer);
          color: var(--link);
        }
      }
    }
    .sections-h {
      padding: var(--sp-03) var(--sp-05);
      background: var(--header-bg);
      color: var(--header-fg);
      font-size: var(--type-label);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .event-main {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-05);
      min-inline-size: 0;
      & > * {
        scroll-margin-block-start: calc(var(--header-height) + var(--sp-04));
      }
    }
    .hero {
      display: grid;
      background: var(--surface);
      border-block-start: 4px solid var(--header-accent);
    }
    .hero-top {
      display: flex;
      align-items: center;
      gap: var(--sp-05);
      padding: var(--sp-06) var(--sp-05);
      background: var(--inverse);
      color: var(--on-inverse);
      & h1 {
        font-size: var(--type-heading-lg);
        font-weight: 600;
        line-height: 1.15;
        text-wrap: balance;
      }
    }
    .hero-title {
      display: grid;
      gap: var(--sp-03);
    }
    .badges {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-02);
    }
    .facts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
      margin: 0;
      & > div {
        display: grid;
        gap: var(--sp-01);
        padding: var(--sp-04) var(--sp-05);
        border-inline-end: var(--border-width) solid var(--border-subtle);
      }
      & dt {
        font-size: var(--type-label);
        color: var(--text-secondary);
      }
      & dd {
        margin: 0;
        font-weight: 600;
      }
    }
    .inline-team {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-02);
    }
    .block {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      min-inline-size: 0;
    }
    .block-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--sp-02) var(--sp-04);
      padding: var(--sp-04) var(--sp-05);
      background: var(--surface);
      border-block-end: 2px solid var(--text-primary);
      & h2 {
        font-size: var(--type-heading-sm);
      }
    }
    .related {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
      gap: var(--sp-03);
      list-style: none;
      margin: 0;
      padding: var(--sp-04) var(--sp-05);
      & a {
        display: flex;
        align-items: center;
        gap: var(--sp-04);
        padding: var(--sp-03);
        background: var(--layer);
        text-decoration: none;
        &:hover {
          background: var(--layer-hover);
        }
        & > span {
          display: grid;
        }
      }
    }
    .bracket-wrap {
      position: relative;
      overflow-x: auto;
      padding: var(--sp-05);
      background: var(--surface);
    }
    .bracket {
      display: flex;
      gap: var(--sp-07);
      list-style: none;
      margin: 0;
      padding: 0;
      inline-size: max-content;
    }
    .round {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: var(--sp-03);
      min-inline-size: 15rem;
    }
    .round-h {
      font-size: var(--type-label);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }
    .round-matches {
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      gap: var(--sp-04);
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .pm {
      display: grid;
      text-decoration: none;
      color: inherit;
      border: var(--border-width) solid var(--border-subtle);
      &.live {
        border-color: var(--live);
      }
      &:hover {
        border-color: var(--border-strong);
      }
    }
    .pm-team {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--sp-03);
      padding: var(--sp-02) var(--sp-03);
      & + & {
        border-block-start: var(--border-width) solid var(--border-subtle);
      }
      &.won {
        font-weight: 600;
        & .pm-score {
          color: var(--win);
        }
      }
      &.lost {
        color: var(--text-secondary);
      }
    }
    .pm-name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .pm-score {
      font-family: var(--font-mono);
    }
    .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
      list-style: none;
      margin: 0;
      padding: 0;
      & li {
        border-block-end: var(--border-width) solid var(--border-subtle);
        border-inline-end: var(--border-width) solid var(--border-subtle);
      }
      & a {
        display: flex;
        align-items: center;
        gap: var(--sp-04);
        padding: var(--sp-04) var(--sp-05);
        text-decoration: none;
        outline-offset: calc(var(--focus-width) * -1);
        &:hover {
          background: var(--layer);
        }
        & > span {
          display: grid;
        }
      }
      & .subtle {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-02);
      }
    }
    .format {
      display: grid;
      gap: var(--sp-03);
      margin: 0;
      padding: var(--sp-04) var(--sp-05) var(--sp-04) var(--sp-07);
      color: var(--text-secondary);
    }
    .pool {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
      list-style: none;
      margin: 0;
      padding: 0;
      & li {
        display: grid;
        gap: var(--sp-01);
        padding: var(--sp-04) var(--sp-05);
        border-block-end: var(--border-width) solid var(--border-subtle);
        border-inline-end: var(--border-width) solid var(--border-subtle);
      }
    }
    .pool-name {
      font-weight: 600;
    }
  }
</style>

---
import LiveRegion from "../../components/LiveRegion.astro";
import Base from "../../layouts/Base.astro";
import EventCard from "../../components/EventCard.astro";
import Panel from "../../components/Panel.astro";
import { getEvents, type EventStatus } from "../../data";

const groups: { status: EventStatus; title: string }[] = [
  { status: "ongoing", title: "Ongoing" },
  { status: "upcoming", title: "Upcoming" },
  { status: "completed", title: "Completed" },
];
---

<Base title="Events" description="ISEC CS2 tournaments: ongoing, upcoming and completed.">
  <LiveRegion key="events" deps={["event:*"]}>
  <header class="page-head">
    <h1>Events</h1>
    <p>All ISEC competitions — from academy leagues to the Masters.</p>
  </header>

  <div class="stack">
    {
      groups.map((g) => {
        const list = getEvents().filter((e) => e.status === g.status);
        return (
          list.length > 0 && (
            <Panel title={g.title} id={`events-${g.status}`}>
              <div class="grid-auto event-grid" style="--grid-min: 18rem">
                {list.map((e) => (
                  <EventCard event={e} />
                ))}
              </div>
            </Panel>
          )
        );
      })
    }
  </div>
  </LiveRegion>
</Base>

<style>
  @layer components {
    .event-grid {
      background: var(--border-subtle);
      border: var(--border-width) solid var(--border-subtle);
      border-block-start: 0;
    }
  }
</style>

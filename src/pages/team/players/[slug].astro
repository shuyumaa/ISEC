---
import Admin from "../../../layouts/Admin.astro";
import CountrySelect from "../../../components/admin/CountrySelect.astro";
import Photo from "../../../components/Photo.astro";
import TransferRow from "../../../components/TransferRow.astro";
import { findPlayer, getRequests, getTeams, playerElo, playerSummary, transfersFor } from "../../../data";
import { handlePost } from "../../../server/handle";
import { ROLES } from "../../../server/mutations";
import { requestTransfer, teamSavePlayer } from "../../../server/team";
import { removeUpload, saveUpload } from "../../../server/uploads";

const me = Astro.locals.user!;
const slug = Astro.params.slug ?? "";
const isNew = slug === "new";

const result = await handlePost(Astro.request, async (form, intent) => {
  if (intent === "request") {
    requestTransfer(me.team, form);
    return { message: "Request sent to ISEC. You'll see the decision under Requests." };
  }
  const old = isNew ? undefined : findPlayer(slug)?.photo;
  const uploaded = await saveUpload(form, "photo", "Photo");
  const photo = form.get("removePhoto") ? null : uploaded;
  const p = teamSavePlayer(me.team, isNew ? undefined : slug, form, photo);
  if (old && (photo === null || uploaded)) await removeUpload(old);
  return { redirect: `/team/players/${p.slug}/`, message: isNew ? "Player added to your roster" : "Player saved" };
});
if (result instanceof Response) return result;

const p = isNew ? undefined : findPlayer(slug);
// A team account only ever sees its own players.
if (!isNew && (!p || p.team !== me.team)) return Astro.rewrite("/404");
const elo = p ? playerElo(p.slug) : undefined;
const summary = p ? playerSummary(p.slug) : undefined;
const history = p ? transfersFor(p.slug) : [];
const pending = p ? getRequests().find((r) => r.player === p.slug && r.status === "pending") : undefined;
const others = getTeams().filter((t) => t.slug !== me.team).toSorted((a, b) => a.name.localeCompare(b.name));
const blank = { slug: "new", nickname: "", firstName: "", lastName: "", team: "", role: "Rifler", countryCode: "", age: 0 } as const;
---

<Admin title={p ? p.nickname : "Add a player"} panel="team" error={result?.error}>
  <a slot="actions" class="btn ghost" href="/team/players/">All players</a>
  {p && <a slot="actions" class="btn ghost" href={`/players/${p.slug}/`} target="_blank" rel="noopener">View profile</a>}

  <div class="editor">
    <form method="post" class="form editor-main" enctype="multipart/form-data" id="player-form">
      <input type="hidden" name="intent" value="save" />
      <fieldset>
        <legend>Profile</legend>
        <div class="form-grid">
          <div class="field"><label for="nickname">Nickname</label><input id="nickname" name="nickname" required maxlength="32" autocomplete="off" value={p?.nickname ?? ""} /></div>
          <div class="field"><label for="firstName">First name</label><input id="firstName" name="firstName" maxlength="40" autocomplete="off" value={p?.firstName ?? ""} /></div>
          <div class="field"><label for="lastName">Last name</label><input id="lastName" name="lastName" maxlength="40" autocomplete="off" value={p?.lastName ?? ""} /></div>
          <div class="field"><label for="countryCode">Country</label><CountrySelect id="countryCode" value={p?.countryCode} /></div>
          <div class="field"><label for="age">Age</label><input id="age" name="age" type="number" min="10" max="60" inputmode="numeric" value={p?.age || ""} /></div>
          <div class="field"><label for="role">Role</label><select id="role" name="role">{ROLES.map((r) => <option selected={(p?.role ?? "Rifler") === r}>{r}</option>)}</select></div>
        </div>
      </fieldset>
      <fieldset>
        <legend>Game server</legend>
        <div class="form-grid">
          <div class="field"><label for="ign">In-game name (if different)</label><input id="ign" name="ign" maxlength="64" autocomplete="off" spellcheck="false" value={p?.ign ?? ""} /></div>
          <div class="field"><label for="steamId">Steam ID</label><input id="steamId" name="steamId" maxlength="32" autocomplete="off" spellcheck="false" inputmode="numeric" placeholder="7656… or [U:1:…]" value={p?.steamId ?? ""} aria-describedby="steam-hint" /><span id="steam-hint" class="hint">Lets the game server match this player's stats automatically.</span></div>
          <div class="field"><label for="joined">On team since</label><input id="joined" name="joined" type="date" value={p?.joined ?? ""} /></div>
        </div>
      </fieldset>
      <div class="actions"><button type="submit" class="btn">{isNew ? "Add to roster" : "Save player"}</button></div>
    </form>

    <aside class="editor-side" aria-label="Photo, numbers and moves">
      <div class="side-card">
        <div class="portrait"><Photo player={p ?? blank} size="card" /></div>
        <div class="field"><label for="photo">Photo (portrait 4:5, up to 5 MB)</label><input id="photo" name="photo" type="file" accept="image/png,image/jpeg,image/webp" form="player-form" /></div>
        {p?.photo && <label class="check"><input type="checkbox" name="removePhoto" form="player-form" /> Remove the current photo</label>}
      </div>

      {
        p && (
          <dl class="side-card numbers">
            <div><dt>Elo</dt><dd>{elo?.elo ?? "—"}</dd></div>
            <div><dt>Maps</dt><dd>{summary?.maps ?? 0}</dd></div>
          </dl>
        )
      }

      {
        p && (
          <div class="side-card">
            <h2 class="side-h">Request a move</h2>
            {pending ? (
              <p class="muted">A request for {p.nickname} is waiting for ISEC. <a href="/team/requests/">See requests</a>.</p>
            ) : (
              <form method="post" class="form">
                <input type="hidden" name="intent" value="request" />
                <input type="hidden" name="direction" value="out" />
                <input type="hidden" name="player" value={p.slug} />
                <div class="field">
                  <label for="to">Move {p.nickname} to</label>
                  <select id="to" name="to" required>
                    <option value="free">Release (free agent)</option>
                    <option value="retired">Retire</option>
                    <optgroup label="Another team">{others.map((t) => <option value={t.slug}>{t.name}</option>)}</optgroup>
                  </select>
                </div>
                <div class="field"><label for="note">Note for ISEC (optional)</label><input id="note" name="note" maxlength="200" /></div>
                <button type="submit" class="btn ghost small">Send request</button>
              </form>
            )}
          </div>
        )
      }

      {
        history.length > 0 && (
          <div class="side-card">
            <h2 class="side-h">Move history</h2>
            <ol class="moves">{history.map((m) => <TransferRow transfer={m} />)}</ol>
          </div>
        )
      }
    </aside>
  </div>
</Admin>

<style>
  @layer components {
    .editor {
      display: grid;
      gap: var(--sp-04);
      align-items: start;
      grid-template-columns: minmax(0, 1fr);
      @container page (width >= 64rem) {
        grid-template-columns: minmax(0, 1fr) 20rem;
      }
    }
    .editor-main {
      max-inline-size: none;
      padding: var(--sp-04);
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
    }
    .editor-side {
      display: grid;
      gap: var(--sp-04);
    }
    .side-card {
      display: grid;
      gap: var(--sp-04);
      padding: var(--sp-04);
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
    }
    .side-card .form {
      gap: var(--sp-04);
    }
    .portrait {
      inline-size: 9rem;
      justify-self: center;
    }
    .check {
      display: flex;
      gap: var(--sp-03);
      align-items: center;
    }
    .numbers {
      grid-template-columns: repeat(2, 1fr);
      margin: 0;
      & dt {
        font-size: var(--type-label);
        color: var(--text-secondary);
      }
      & dd {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--type-heading-sm);
      }
    }
    .side-h {
      font-size: var(--type-body);
    }
    .moves {
      display: grid;
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }
</style>

---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MatchRow from "../../components/MatchRow.astro";
import Panel from "../../components/Panel.astro";
import TeamMark from "../../components/TeamMark.astro";
import { matchesForTeam, players, playerSummary, signed, team, type Player } from "../../data";

export function getStaticPaths() {
  return players.map((p) => ({ params: { slug: p.slug }, props: { player: p } }));
}

interface Props {
  player: Player;
}
const { player: p } = Astro.props;
const t = team(p.team);
const s = playerSummary(p.slug);
const recent = matchesForTeam(t.slug).filter((m) => m.status === "completed").slice(0, 6);

// Per-match rating for this player, newest first.
const log = recent.map((m) => {
  const rows = m.maps.flatMap((map) => map.stats?.filter((x) => x.player === p.slug).map((x) => ({ ...x, rounds: (map.scoreA ?? 0) + (map.scoreB ?? 0) })) ?? []);
  const rounds = rows.reduce((n, r) => n + r.rounds, 0) || 1;
  return {
    match: m,
    kills: rows.reduce((n, r) => n + r.kills, 0),
    deaths: rows.reduce((n, r) => n + r.deaths, 0),
    rating: rows.reduce((n, r) => n + r.rating * r.rounds, 0) / rounds,
  };
});
---

<Base title={`${p.nickname} (${p.firstName} ${p.lastName})`} description={`${p.nickname} of ${t.name}: stats and recent matches.`}>
  <Breadcrumbs items={[{ label: "Stats", href: "/stats/" }, { label: p.nickname, href: `/players/${p.slug}/` }]} />

  <header class="player-head">
    <span class="eyebrow">{p.role}</span>
    <h1>{p.nickname}</h1>
    <p class="muted">
      {p.firstName} {p.lastName} · {p.age} years · {p.countryCode} ·
      <a href={`/teams/${t.slug}/`} class="team-link"><TeamMark team={t} /> {t.name}</a>
    </p>
  </header>

  {
    s ? (
      <dl class="facts">
        <div><dt>Rating</dt><dd class="big">{s.rating.toFixed(2)}</dd></div>
        <div><dt>Maps</dt><dd>{s.maps}</dd></div>
        <div><dt>K–D</dt><dd>{s.kills}–{s.deaths} ({signed(s.diff)})</dd></div>
        <div><dt>K/D ratio</dt><dd>{s.kd.toFixed(2)}</dd></div>
        <div><dt>ADR</dt><dd>{s.adr}</dd></div>
        <div><dt>KAST</dt><dd>{s.kast}%</dd></div>
        <div><dt>Headshots</dt><dd>{s.hs}%</dd></div>
      </dl>
    ) : (
      <p class="empty">No completed maps yet.</p>
    )
  }

  {
    log.length > 0 && (
      <Panel title="Recent matches" id="player-matches" class="player-log">
        <div class="table-wrap" role="region" aria-labelledby="log-caption" tabindex="0">
          <table class="data-table">
            <caption id="log-caption" class="visually-hidden">Recent matches for {p.nickname}</caption>
            <thead>
              <tr><th scope="col">Match</th><th scope="col" class="n">K–D</th><th scope="col" class="n">Rating</th></tr>
            </thead>
            <tbody>
              {log.map((l) => (
                <tr>
                  <th scope="row"><a href={`/matches/${l.match.id}/`}>{team(l.match.teamA).name} vs {team(l.match.teamB).name}</a></th>
                  <td class="n">{l.kills}–{l.deaths}</td>
                  <td class:list={["n", { won: l.rating >= 1 }]}>{l.rating.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Panel>
    )
  }

  {recent.length > 0 && <Panel title="Team results" id="player-results" class="player-log">{recent.map((m) => <MatchRow match={m} showDate />)}</Panel>}
</Base>

<style>
  @layer components {
    .player-head {
      display: grid;
      gap: var(--sp-02);
      margin-block: var(--sp-06);

      & h1 {
        font-size: var(--type-display);
        font-weight: 300;
        line-height: 1;
      }
      & .eyebrow {
        font-size: var(--type-label);
        letter-spacing: 0.032em;
        text-transform: uppercase;
        color: var(--text-secondary);
      }
    }
    .team-link {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-02);
      vertical-align: middle;
    }
    .big {
      font-family: var(--font-mono);
      font-weight: 600;
    }
    .player-log {
      margin-block-start: var(--sp-07);
    }
  }
</style>

---
import Base from "../../../layouts/Base.astro";
import LiveRegion from "../../../components/LiveRegion.astro";
import Photo from "../../../components/Photo.astro";
import TeamMark from "../../../components/TeamMark.astro";
import { comparison, findPlayer, getEvents, getSeasons, playerAttributes, ratingTone, team, type AggregatedStats } from "../../../data";

const p = findPlayer(Astro.params.slug ?? "");
if (!p) return Astro.rewrite("/404");
const t = team(p.team);
const q = Astro.url.searchParams;
const f = { season: q.get("season") || undefined, event: q.get("event") || undefined, sameRole: q.get("compare") === "role" };
const cmp = comparison(p.slug, f);
const attrs = playerAttributes(p.slug, f) ?? [];
const s = cmp?.me;

type Tile = { label: string; value: string; pct: number; higherIsBetter?: boolean };
const verdict = (pct: number) => (pct >= 60 ? "good" : pct >= 35 ? "okay" : "poor");
const openingRate = (x: AggregatedStats) => (x.firstKills + x.firstDeaths ? x.firstKills / (x.firstKills + x.firstDeaths) : 0);
const tiles: Tile[] = s && cmp
  ? [
      { label: "KPR", value: (s.kills / s.rounds).toFixed(2), pct: cmp.percentile((x) => x.kills / x.rounds) },
      // DPR: lower is better, so the percentile is inverted.
      { label: "DPR", value: (s.deaths / s.rounds).toFixed(2), pct: 100 - cmp.percentile((x) => x.deaths / x.rounds) },
      { label: "KAST", value: `${s.kast.toFixed(1)}%`, pct: cmp.percentile((x) => x.kast) },
      { label: "ADR", value: s.adr.toFixed(1), pct: cmp.percentile((x) => x.adr) },
      { label: "Opening success", value: `${Math.round(openingRate(s) * 100)}%`, pct: cmp.percentile(openingRate) },
      { label: "HS%", value: `${s.hs.toFixed(1)}%`, pct: cmp.percentile((x) => x.hs) },
    ]
  : [];

// Rating gauge: a 180° arc filled to the rating, on a 0.5–1.5 scale.
const ratingPct = s ? Math.max(0, Math.min(1, (s.rating - 0.5) / 1)) : 0;
const arc = (pct: number) => {
  const a = Math.PI * (1 - pct);
  return `${(60 + 50 * Math.cos(a)).toFixed(2)} ${(60 - 50 * Math.sin(a)).toFixed(2)}`;
};
const ratingWord = s ? { good: "Good", even: "Average", poor: "Poor" }[ratingTone(s.rating)] : "";
const firepower = attrs.find((a) => a.key === "firepower");
const others = attrs.filter((a) => a.key !== "firepower");
---

<Base title={`${p.nickname} statistics`} description={`${p.nickname}'s rating, KPR, DPR, KAST, ADR and attribute profile.`}>
  <search>
    <form method="get" class="adv-filters" aria-label="Advanced filters">
      <span class="af-title">Advanced filters</span>
      <div class="af-field">
        <label for="af-season">Season</label>
        <select id="af-season" name="season">
          <option value="">All time</option>
          {getSeasons().map((x) => <option value={x.slug} selected={f.season === x.slug}>{x.name}</option>)}
        </select>
      </div>
      <div class="af-field">
        <label for="af-event">Event</label>
        <select id="af-event" name="event">
          <option value="">All</option>
          {getEvents().map((e) => <option value={e.slug} selected={f.event === e.slug}>{e.name}</option>)}
        </select>
      </div>
      <div class="af-field">
        <label for="af-compare">Compared to</label>
        <select id="af-compare" name="compare">
          <option value="">Everyone</option>
          <option value="role" selected={f.sameRole}>Same role ({p.role})</option>
        </select>
      </div>
      <button type="submit" class="btn">Apply</button>
    </form>
  </search>

  <LiveRegion key="pstats" deps={[`player:${p.slug}`, "match:*"]}>
    <section class="stats-hero" aria-labelledby="ps-name">
      <div class="hero-player">
        <span class="hero-icons" aria-hidden="true"><span class="cc">{p.countryCode}</span><TeamMark team={t} /></span>
        <Photo player={p} size="hero" />
        <div class="hero-name">
          <h1 id="ps-name">{p.nickname}</h1>
          <p>{p.firstName} {p.lastName}{p.age ? ` · ${p.age} years` : ""}</p>
          <a href={`/players/${p.slug}/`} class="btn ghost small">Player profile</a>
        </div>
      </div>

      {
        s ? (
          <div class="hero-stats">
            <p class="maps subtle">{s.maps} maps · compared to {f.sameRole ? `${p.role}s` : "everyone"}</p>
            <div class="gauge-row">
              <div class="flank">
                <span class="flank-v">{s.kd.toFixed(2)}</span>
                <span class="flank-l">K/D</span>
              </div>
              <div class="gauge">
                <svg viewBox="0 0 120 70" aria-hidden="true">
                  <path d="M10 60 A50 50 0 0 1 110 60" class="track" />
                  <path d={`M10 60 A50 50 0 0 1 ${arc(ratingPct)}`} class:list={["fill", ratingTone(s.rating)]} />
                </svg>
                <span class:list={["g-word", ratingTone(s.rating)]}>{ratingWord}</span>
                <span class="g-value">{s.rating.toFixed(2)}</span>
                <span class="g-label">Rating</span>
              </div>
              <div class="flank">
                <span class="flank-v">{s.rws.toFixed(2)}</span>
                <span class="flank-l">RWS</span>
              </div>
            </div>
            <ul class="tiles">
              {tiles.map((tile) => (
                <li>
                  <span class="t-value">{tile.value}</span>
                  <span class="t-label">{tile.label}</span>
                  <span class="t-track" aria-hidden="true"><span style={`--v: ${tile.pct}%`} class={verdict(tile.pct)} /></span>
                  <span class:list={["t-verdict", verdict(tile.pct)]}>
                    {verdict(tile.pct)}
                    <span class="visually-hidden">, {tile.pct}th percentile</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="empty">No completed maps match these filters.</p>
        )
      }
    </section>

    {
      firepower && (
        <section class="attr-grid" aria-label="Attributes">
          {[firepower, ...others].map((a, i) => (
            <article class:list={["attr-card", { wide: i === 0 }]} aria-labelledby={`attr-${a.key}`}>
              <div class="attr-head">
                <h2 id={`attr-${a.key}`}>{a.label}</h2>
                <span class="attr-score">
                  {a.score}<span class="subtle">/100</span>
                </span>
              </div>
              <p class="attr-src subtle">From {a.source}: {a.raw}</p>
              <span class="attr-bar" aria-hidden="true"><span style={`--v: ${a.score}%`} /></span>
            </article>
          ))}
        </section>
      )
    }
  </LiveRegion>
</Base>

<style>
  @layer components {
    .adv-filters {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: var(--sp-04) var(--sp-05);
      padding: var(--sp-04) var(--sp-05);
      margin-block-end: var(--sp-05);
      background: var(--surface);
      & .btn {
        min-block-size: 2.5rem;
      }
    }
    .af-title {
      flex-basis: 100%;
      font-size: var(--type-label);
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }
    .af-field {
      display: grid;
      gap: var(--sp-01);
      & label {
        font-size: var(--type-label);
        color: var(--text-secondary);
      }
      & select {
        min-block-size: 2.5rem;
        padding: 0 var(--sp-04);
        border: 0;
        border-block-end: var(--border-width) solid var(--border-strong);
        background: var(--layer);
        font-size: max(1rem, 1em);
      }
    }
    .stats-hero {
      display: grid;
      background: var(--surface);
      @container page (width >= 48rem) {
        grid-template-columns: 17rem minmax(0, 1fr);
      }
    }
    .hero-player {
      position: relative;
      background: linear-gradient(var(--layer-selected), var(--layer));
      max-inline-size: 22rem;
    }
    .hero-icons {
      position: absolute;
      inset-block-start: var(--sp-04);
      inset-inline-start: var(--sp-04);
      z-index: 1;
      display: grid;
      gap: var(--sp-03);
      & .cc {
        padding: 0 var(--sp-02);
        background: var(--surface);
        font-family: var(--font-mono);
        font-size: var(--type-label);
      }
    }
    .hero-name {
      position: absolute;
      inset: auto 0 0;
      display: grid;
      justify-items: center;
      gap: var(--sp-02);
      padding: var(--sp-07) var(--sp-04) var(--sp-04);
      background: linear-gradient(transparent, var(--surface) 55%);
      text-align: center;
      & h1 {
        font-size: var(--type-heading);
        font-weight: 600;
        line-height: 1;
      }
      & p {
        font-size: var(--type-body-sm);
      }
    }
    .hero-stats {
      display: grid;
      align-content: start;
      gap: var(--sp-05);
      padding: var(--sp-05) var(--sp-06);
    }
    .maps {
      justify-self: end;
      font-size: var(--type-label);
    }
    .gauge-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--sp-05);
    }
    .flank {
      display: grid;
      justify-items: center;
      &:first-child {
        justify-items: end;
      }
      &:last-child {
        justify-items: start;
      }
    }
    .flank-v {
      font-family: var(--font-mono);
      font-size: var(--type-heading);
      font-weight: 600;
      color: var(--side-t);
    }
    .flank:last-child .flank-v {
      color: var(--side-ct);
    }
    .flank-l {
      font-size: var(--type-label);
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .gauge {
      position: relative;
      display: grid;
      justify-items: center;
      inline-size: 12rem;
      & svg {
        inline-size: 100%;
      }
      & .track,
      & .fill {
        fill: none;
        stroke-width: 7;
        stroke-linecap: round;
      }
      & .track {
        stroke: var(--layer-hover);
      }
      & .fill {
        stroke: var(--text-secondary);
        &.good {
          stroke: var(--win);
        }
        &.poor {
          stroke: var(--loss);
        }
      }
    }
    .g-word {
      position: absolute;
      inset-block-start: 22%;
      font-size: var(--type-label);
      font-weight: 600;
      text-transform: uppercase;
      &.good {
        color: var(--win);
      }
      &.poor {
        color: var(--loss);
      }
    }
    .g-value {
      position: absolute;
      inset-block-start: 38%;
      font-family: var(--font-mono);
      font-size: var(--type-heading-lg);
      font-weight: 600;
      line-height: 1;
    }
    .g-label {
      font-size: var(--type-label);
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .tiles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
      gap: var(--sp-05) var(--sp-06);
      list-style: none;
      margin: 0;
      padding: 0;
      & li {
        display: grid;
        justify-items: center;
        gap: var(--sp-01);
      }
    }
    .t-value {
      font-family: var(--font-mono);
      font-size: var(--type-heading);
      font-weight: 600;
    }
    .t-label {
      font-size: var(--type-label);
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .t-track {
      position: relative;
      inline-size: 100%;
      block-size: 3px;
      background: var(--layer-hover);
      & span {
        position: absolute;
        inset-block: -4px;
        inset-inline-start: var(--v);
        inline-size: 3px;
        background: var(--text-secondary);
        &.good {
          background: var(--win);
        }
        &.okay {
          background: var(--side-t);
        }
        &.poor {
          background: var(--loss);
        }
      }
    }
    .t-verdict {
      justify-self: end;
      font-size: var(--type-label);
      font-weight: 600;
      text-transform: uppercase;
      &.good {
        color: var(--win);
      }
      &.okay {
        color: var(--side-t);
      }
      &.poor {
        color: var(--loss);
      }
    }
    .attr-grid {
      display: grid;
      gap: var(--sp-04);
      margin-block-start: var(--sp-05);
      @container page (width >= 40rem) {
        grid-template-columns: 1fr 1fr;
      }
    }
    .attr-card {
      display: grid;
      gap: var(--sp-02);
      padding: var(--sp-04) var(--sp-05);
      background: var(--surface);
      &.wide {
        grid-column: 1 / -1;
      }
    }
    .attr-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      & h2 {
        font-size: var(--type-heading-sm);
      }
    }
    .attr-score {
      font-family: var(--font-mono);
      font-weight: 600;
    }
    .attr-src {
      font-size: var(--type-label);
    }
    .attr-bar {
      block-size: 0.25rem;
      background: var(--layer-hover);
      & span {
        display: block;
        block-size: 100%;
        inline-size: var(--v);
        background: var(--link);
      }
    }
  }
</style>

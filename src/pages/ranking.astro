---
import { Temporal } from "temporal-polyfill";
import LiveRegion from "../components/LiveRegion.astro";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import TeamMark from "../components/TeamMark.astro";
import Flag from "../components/Flag.astro";
import { eloSettings, getRanking, getRankingUpdated, getSettings, rosterOf, team } from "../data";
const cfg = eloSettings();

const ranking = getRanking();
const rankingUpdated = getRankingUpdated();

const updated = rankingUpdated
  ? Temporal.PlainDate.from(rankingUpdated).toLocaleString("en-GB", { day: "numeric", month: "long", year: "numeric" })
  : "—";
---

<Base title={getSettings().rankingName} description="The ISEC CS2 school teams ranking.">
  <LiveRegion key="ranking" deps={["ranking:*", "team:*", "player:*", "match:*", "event:*", "settings:*"]}>
  <header class="page-head">
    <h1>{getSettings().rankingName}</h1>
    <p>Updated <time datetime={rankingUpdated}>{updated}</time>. {getSettings().intros.ranking}</p>
  </header>

  <details class="how-points">
    <summary>How points work</summary>
    <ul>
      <li>Every team starts on {cfg.start} points. A win takes points from the loser; the total never changes.</li>
      <li>The surprise decides the size: an upset win pays a lot, beating a much weaker team pays little.</li>
      <li>Majors count {cfg.tier.Major}×, Premier {cfg.tier.Premier}×, Open {cfg.tier.Open}× and Academy {cfg.tier.Academy}×. Bo5 counts {cfg.format.bo5}×, Bo1 {cfg.format.bo1}×.</li>
      <li>Each extra map of winning margin (2–0 rather than 2–1) adds {Math.round(cfg.marginStep * 100)}%.</li>
      <li>Movement compares positions with 7 days ago.</li>
    </ul>
  </details>

  <div class="table-wrap" role="region" aria-labelledby="ranking-caption" tabindex="0">
    <table class="data-table ranking-table">
      <caption id="ranking-caption" class="visually-hidden">ISEC {getSettings().rankingName}</caption>
      <thead>
        <tr>
          <th scope="col" class="n">#</th>
          <th scope="col">Team</th>
          <th scope="col" class="hide-sm">Roster</th>
          <th scope="col" class="n hide-sm">W–L</th>
          <th scope="col" class="n">Points</th>
          <th scope="col" class="n">Change</th>
        </tr>
      </thead>
      <tbody>
        {
          ranking.map((r, i) => {
            const t = team(r.team);
            return (
              <tr>
                <td class="n pos">{i + 1}</td>
                <th scope="row">
                  <a class="team-cell" href={`/teams/${t.slug}/`}>
                    <TeamMark team={t} size="md" />
                    <span>
                      <strong>{t.name}</strong>
                      <span class="subtle"><Flag code={t.countryCode} /> {t.country}</span>
                    </span>
                  </a>
                </th>
                <td class="hide-sm muted">{rosterOf(t.slug).map((p) => p.nickname).join(", ")}</td>
                <td class="n mono hide-sm">{r.wins}–{r.losses}</td>
                <td class="n mono">{r.points}</td>
                <td class="n">
                  {r.change === 0 ? (
                    <span>–<span class="visually-hidden"> no change</span></span>
                  ) : (
                    <span class:list={["chg", r.change > 0 ? "up" : "down"]}>
                      <Icon name={r.change > 0 ? "up" : "down"} size={12} />
                      <span class="visually-hidden">{r.change > 0 ? "up" : "down"}</span>
                      {Math.abs(r.change)}
                    </span>
                  )}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  </LiveRegion>
</Base>

<style>
  @layer components {
    .how-points {
      margin-block-end: var(--sp-05);
      padding: var(--sp-04) var(--sp-05);
      background: var(--surface);
      border: var(--border-width) solid var(--border-subtle);
      & summary {
        cursor: pointer;
        font-weight: 600;
      }
      & ul {
        display: grid;
        gap: var(--sp-02);
        margin: var(--sp-03) 0 0;
        padding-inline-start: var(--sp-05);
        color: var(--text-secondary);
        max-inline-size: 70ch;
      }
    }
    .ranking-table {
      & .pos {
        font-family: var(--font-mono);
        font-size: var(--type-heading-sm);
        inline-size: 3rem;
      }
      & tbody tr:nth-child(-n + 3) .pos {
        font-weight: 600;
      }
    }
    .team-cell {
      display: flex;
      align-items: center;
      gap: var(--sp-04);
      text-decoration: none;
      & > span {
        display: grid;
      }
      &:hover strong {
        text-decoration: underline;
      }
    }
    .chg {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-01);
    }
    @container (width < 40rem) {
      .hide-sm {
        display: none;
      }
    }
  }
</style>

---
import { Temporal } from "temporal-polyfill";
import LiveRegion from "../components/LiveRegion.astro";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import TeamMark from "../components/TeamMark.astro";
import { getRanking, getRankingUpdated, getSettings, rosterOf, team } from "../data";

const ranking = getRanking();
const rankingUpdated = getRankingUpdated();

const updated = rankingUpdated
  ? Temporal.PlainDate.from(rankingUpdated).toLocaleString("en-GB", { day: "numeric", month: "long", year: "numeric" })
  : "—";
---

<Base title={getSettings().rankingName} description="The ISEC CS2 school teams ranking.">
  <LiveRegion key="ranking" deps={["ranking:*", "team:*", "player:*", "meta:*"]}>
  <header class="page-head">
    <h1>{getSettings().rankingName}</h1>
    <p>Updated <time datetime={rankingUpdated}>{updated}</time>. Points weigh the last six months of results by event tier, opponent strength and recency.</p>
  </header>

  <div class="table-wrap" role="region" aria-labelledby="ranking-caption" tabindex="0">
    <table class="data-table ranking-table">
      <caption id="ranking-caption" class="visually-hidden">ISEC {getSettings().rankingName}</caption>
      <thead>
        <tr>
          <th scope="col" class="n">#</th>
          <th scope="col">Team</th>
          <th scope="col" class="hide-sm">Roster</th>
          <th scope="col" class="n">Points</th>
          <th scope="col" class="n">Change</th>
        </tr>
      </thead>
      <tbody>
        {
          ranking.map((r, i) => {
            const t = team(r.team);
            return (
              <tr>
                <td class="n pos">{i + 1}</td>
                <th scope="row">
                  <a class="team-cell" href={`/teams/${t.slug}/`}>
                    <TeamMark team={t} size="md" />
                    <span>
                      <strong>{t.name}</strong>
                      <span class="subtle">{t.country}</span>
                    </span>
                  </a>
                </th>
                <td class="hide-sm muted">{rosterOf(t.slug).map((p) => p.nickname).join(", ")}</td>
                <td class="n mono">{r.points}</td>
                <td class="n">
                  {r.change === 0 ? (
                    <span>–<span class="visually-hidden"> no change</span></span>
                  ) : (
                    <span class:list={["chg", r.change > 0 ? "up" : "down"]}>
                      <Icon name={r.change > 0 ? "up" : "down"} size={12} />
                      <span class="visually-hidden">{r.change > 0 ? "up" : "down"}</span>
                      {Math.abs(r.change)}
                    </span>
                  )}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  </LiveRegion>
</Base>

<style>
  @layer components {
    .ranking-table {
      & .pos {
        font-family: var(--font-mono);
        font-size: var(--type-heading-sm);
        inline-size: 3rem;
      }
      & tbody tr:nth-child(-n + 3) .pos {
        font-weight: 600;
      }
    }
    .team-cell {
      display: flex;
      align-items: center;
      gap: var(--sp-04);
      text-decoration: none;
      & > span {
        display: grid;
      }
      &:hover strong {
        text-decoration: underline;
      }
    }
    .chg {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-01);
    }
    @container (width < 40rem) {
      .hide-sm {
        display: none;
      }
    }
  }
</style>

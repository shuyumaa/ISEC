---
import LiveRegion from "../../components/LiveRegion.astro";
import Base from "../../layouts/Base.astro";
import NewsList from "../../components/NewsList.astro";
import { getArticles } from "../../data";

const sorted = getArticles();
---

<Base title="News" description="ISEC news, interviews and analysis.">
  <LiveRegion key="news" deps={["article:*"]}>
  <header class="page-head">
    <h1>News</h1>
  </header>
  <div class="news-wrap"><NewsList items={sorted} lead /></div>
  </LiveRegion>
</Base>

<style>
  @layer layout {
    .news-wrap {
      max-inline-size: 50rem;
    }
  }
</style>

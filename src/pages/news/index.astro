---
import Base from "../../layouts/Base.astro";
import NewsList from "../../components/NewsList.astro";
import { articles } from "../../data";

const sorted = [...articles].sort((a, b) => b.published.localeCompare(a.published));
---

<Base title="News" description="ISEC news, interviews and analysis.">
  <header class="page-head">
    <h1>News</h1>
    <p>Announcements, recaps, interviews and ranking analysis from the ISEC circuit.</p>
  </header>
  <div class="news-wrap"><NewsList items={sorted} lead /></div>
</Base>

<style>
  @layer layout {
    .news-wrap {
      max-inline-size: 50rem;
    }
  }
</style>

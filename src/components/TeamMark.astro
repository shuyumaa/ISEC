---
import { mediaUrl } from "../server/media";
import type { Team } from "../data";

interface Props {
  team: Team;
  size?: "sm" | "md" | "lg" | "xl";
}

const { team, size = "sm" } = Astro.props;
---

{
  team.logo ? (
    <span class:list={["team-mark", "logo", size, "protected"]} aria-hidden="true" style={`--img: url(${mediaUrl(team.logo, size === "xl" || size === "lg" ? 320 : 160)})`} />
  ) : (
    <span class:list={["team-mark", size, { tbd: !team.slug }]} aria-hidden="true">{team.tag}</span>
  )
}

<style>
  @layer components {
    .team-mark {
      display: inline-grid;
      place-items: center;
      flex: none;
      inline-size: var(--mark);
      aspect-ratio: 1;
      border: var(--border-width) solid var(--text-primary);
      font-family: var(--font-mono);
      font-size: max(0.5625rem, calc(var(--mark) * 0.3));
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.02em;
      --mark: 1.75rem;

      /* Team still to be decided: a dashed placeholder. */
      &.tbd {
        border-style: dashed;
        border-color: var(--border-strong);
        color: var(--text-muted);
      }
      &.logo {
        border: 0;
        background: var(--img) center / contain no-repeat;
      }
      &.md {
        --mark: 2.5rem;
      }
      &.lg {
        --mark: 4rem;
      }
      &.xl {
        --mark: clamp(4rem, 3rem + 4vw, 7rem);
        border-width: 2px;
      }
    }
  }
</style>

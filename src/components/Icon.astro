export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"><path d={paths[name]} fill-rule={name === "moon" ? undefined : "evenodd"}></path></svg
>

<style>
  @layer components {
    .icon {
      flex: none;
      pointer-events: none;
    }
  }
</style>

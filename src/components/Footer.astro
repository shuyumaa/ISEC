---
import Logo from "./Logo.astro";
---

<footer class="site-footer">
  <div class="footer-inner">
    <a href="/" class="footer-logo" aria-label="ISEC home"><Logo height="clamp(4rem, 2.5rem + 6vw, 8rem)" /></a>
    <nav aria-label="More" class="footer-links">
      <a href="/teams/">Teams</a>
      <a href="/admin/">Admin</a>
    </nav>
    <p class="legal">© 2026 ISEC. Counter-Strike is a trademark of Valve Corporation; ISEC is not affiliated with Valve.</p>
  </div>
</footer>

<style>
  @layer components {
    .site-footer {
      margin-block-start: var(--sp-10);
      border-block-start: var(--border-width) solid var(--border-subtle);
    }
    .footer-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--sp-06) var(--sp-07);
      max-inline-size: var(--container);
      margin-inline: auto;
      padding: var(--sp-08) var(--gutter) var(--sp-07);
    }
    .footer-logo {
      justify-self: start;
    }
    .footer-links {
      display: flex;
      gap: var(--sp-06);
      & a {
        text-decoration: none;
        &:hover {
          text-decoration: underline;
        }
      }
    }
    .legal {
      grid-column: 1 / -1;
      padding-block-start: var(--sp-05);
      border-block-start: var(--border-width) solid var(--border-subtle);
      font-size: var(--type-label);
      color: var(--text-secondary);
    }
  }
</style>

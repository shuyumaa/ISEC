---
import { mediaUrl } from "../server/media";
import type { Player } from "../data";
import { isCutout } from "../server/uploads";

/**
 * Player portrait. Uploaded photos are protected CSS backgrounds (no <img> to
 * save or drag); without a photo a dark HLTV-style silhouette stands in.
 */
interface Props {
  player: Player;
  size?: "thumb" | "card" | "hero";
}
const { player: p, size = "card" } = Astro.props;
---

{
  p.photo ? (
    <span class:list={["photo", size, "protected", { cutout: isCutout(p.photo) }]} role="img" aria-label={`Photo of ${p.nickname}`} style={`--img: url(${mediaUrl(p.photo, size === "thumb" ? 160 : size === "hero" ? 960 : 640)})`} />
  ) : (
    <span class:list={["photo", size, "empty-photo"]} aria-hidden="true">
      <svg viewBox="0 0 120 150" preserveAspectRatio="xMidYMax meet">
        <path d="M60 16c-14 0-23 12-23 28 0 13 5 23 12 28v9c-23 4-41 15-45 35l-2 34h116l-2-34c-4-20-22-31-45-35v-9c7-5 12-15 12-28 0-16-9-28-23-28z" />
      </svg>
    </span>
  )
}

<style>
  @layer components {
    .photo {
      display: block;
      aspect-ratio: 4 / 5;
      background: var(--img) center bottom / cover no-repeat;
      /* A transparent cut-out is shown whole, standing on the bottom edge,
         over whatever backdrop the photo sits on. */
      &.cutout {
        background-size: contain;
      }
      &.thumb {
        inline-size: 2.5rem;
      }
      &.card {
        inline-size: 100%;
      }
      &.hero {
        inline-size: 100%;
      }
    }
    /* Dark head-and-shoulders silhouette on a mid-grey backdrop, readable in
       both themes (the figure stays dark, the backdrop shifts). */
    .empty-photo {
      --sil-bg: var(--gray-30);
      --sil-fg: var(--gray-100);
      display: grid;
      align-items: end;
      background: var(--sil-bg);
      & svg {
        inline-size: 100%;
        block-size: 90%;
        fill: var(--sil-fg);
        opacity: 0.88;
      }
    }
    @media (prefers-color-scheme: dark) {
      :root:not(:has(> head > meta[name="color-scheme"][content="light"])) .empty-photo {
        --sil-bg: var(--gray-70);
      }
    }
    :root:has(> head > meta[name="color-scheme"][content="dark"]) .empty-photo {
      --sil-bg: var(--gray-70);
    }
  }
</style>

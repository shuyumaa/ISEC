---
import Photo from "./Photo.astro";
import TeamMark from "./TeamMark.astro";
import Flag from "./Flag.astro";
import { findTeam, moveLabel, player, type Transfer } from "../data";
import { Temporal } from "temporal-polyfill";

interface Props {
  transfer: Transfer;
  /** Show a remove button (admin). */
  deletable?: boolean;
  /** Narrow rail layout: photo and the move only, name in the tooltip. */
  compact?: boolean;
}
const { transfer: t, deletable = false, compact = false } = Astro.props;
const p = player(t.player);
// A deleted team has no record any more: say so instead of showing "?".
const end = (slug: string, status: Transfer["toStatus"]) => {
  const t = slug ? findTeam(slug) : undefined;
  return { team: t, label: slug && !t ? "Disbanded" : moveLabel(slug, status) };
};
const from = end(t.from, t.fromStatus);
const to = end(t.to, t.toStatus);
const describe = (e: typeof from) => [e.team?.name, e.label].filter(Boolean).join(" ") || "No team";

// What kind of move this is, for the rail's tag (text carries it, colour helps).
const kind = (() => {
  if (t.note === "Team disbanded" || (t.from && !from.team && !t.to)) return { label: "Disbanded", tone: "" };
  if (t.toStatus === "retired") return { label: "Retired", tone: "" };
  if (t.to && t.from === t.to) return t.toStatus === "benched" ? { label: "Benched", tone: "purple" } : { label: "Activated", tone: "green" };
  if (t.to && t.from) return { label: "Transfer", tone: "blue" };
  if (t.to) return { label: "Signed", tone: "green" };
  return { label: "Released", tone: "" };
})();
// "Today", "3d ago", or the date for anything older than a month.
const ago = (() => {
  try {
    const days = Temporal.PlainDate.from(t.date).until(Temporal.Now.plainDateISO()).days;
    if (days === 0) return "Today";
    if (days < 0) return t.date;
    if (days > 0 && days < 31) return `${days}d ago`;
  } catch {
    /* malformed date */
  }
  return t.date;
})();
---

{compact ? (
<li class="move compact" data-kind={kind.label.toLowerCase()}>
  <a class="cm" href={`/players/${p.slug}/`} aria-label={`${p.nickname}: ${kind.label.toLowerCase()}, from ${describe(from)} to ${describe(to)}, ${t.date}`}>
    <span class="cm-photo"><Photo player={p} size="thumb" /></span>
    <span class="cm-top" aria-hidden="true">
      <strong class="cm-name"><Flag code={p.countryCode} /> {p.nickname}</strong>
      <span class:list={["badge", "cm-kind", kind.tone]}>{kind.label}</span>
    </span>
    <span class="cm-path" aria-hidden="true">
      <span class="cm-end">{from.team ? <><TeamMark team={from.team} /><span>{from.team.tag}</span></> : <span class="cm-none">{from.label || "No team"}</span>}</span>
      <svg class="cm-arrow" viewBox="0 0 16 16" width="14" height="14"><path d="M2 8h10M8 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      <span class="cm-end">{to.team && t.to !== t.from ? <><TeamMark team={to.team} /><span>{to.label ? `${to.team.tag} · ${to.label}` : to.team.tag}</span></> : <span class="cm-none">{to.label || (to.team ? "Active" : "No team")}</span>}</span>
      <time class="cm-ago" datetime={t.date}>{ago}</time>
    </span>
  </a>
</li>
) : (
<li class="move">
  <a class="move-who" href={deletable ? `/admin/players/${p.slug}/` : `/players/${p.slug}/`} title={compact ? `${p.nickname}, ${t.date}` : undefined}>
    <Photo player={p} size="thumb" />
    <span class:list={{ "visually-hidden": compact }}>
      <strong>{p.nickname}</strong>
      <time class="muted" datetime={t.date}>{t.date}</time>
    </span>
  </a>
  <span class="move-path" aria-label={`From ${describe(from)} to ${describe(to)}`}>
    <span class="end">{from.team ? <TeamMark team={from.team} size={compact ? "md" : "sm"} /> : <span class="none" aria-hidden="true" />}<span class="lbl">{from.label || from.team?.tag}</span></span>
    <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 8h10M8 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    <span class="end">{to.team ? <TeamMark team={to.team} size={compact ? "md" : "sm"} /> : <span class="none" aria-hidden="true" />}<span class="lbl">{to.label || to.team?.tag}</span></span>
  </span>
  {t.note && <span class="note muted">{t.note}</span>}
  {
    deletable && (
      <form method="post" data-enhance class="move-del">
        <input type="hidden" name="intent" value="delete-transfer" />
        <input type="hidden" name="id" value={t.id} />
        <button class="btn ghost small" aria-label={`Remove this move of ${p.nickname} from the history`}>Remove</button>
      </form>
    )
  }
</li>
)}

<style>
  @layer components {
    .move {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--sp-03) var(--sp-05);
      padding: var(--sp-03) 0;
      border-block-end: var(--border-width) solid var(--border-subtle);
      &:has(.move-del) {
        grid-template-columns: minmax(0, 1fr) auto auto;
      }
    }
    /* Rail layout: a ticker of moves. Round portrait (clipped), name and a
       tag saying what happened, then the path with both team marks. */
    .move.compact {
      display: block;
      padding: 0;
    }
    .cm {
      display: grid;
      grid-template-columns: 2.75rem minmax(0, 1fr);
      grid-template-areas: "photo top" "photo path";
      align-items: center;
      gap: var(--sp-01) var(--sp-03);
      padding: var(--sp-03) var(--sp-04);
      color: inherit;
      text-decoration: none;
      transition: background-color var(--duration-fast-02, 110ms) ease-out;
      &:hover {
        background: var(--layer-hover);
        & .cm-arrow {
          translate: 2px 0;
        }
        & .cm-name {
          text-decoration: underline;
        }
      }
    }
    .cm-photo {
      grid-area: photo;
      position: relative;
      display: block;
      inline-size: 2.75rem;
      aspect-ratio: 1;
      border-radius: 50%;
      overflow: hidden;
      background: var(--layer);
      /* A ring in the move's colour; the tag says it in words. */
      box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--ring, var(--border-subtle));
      & :global(.photo) {
        inline-size: 100%;
        block-size: 100%;
        aspect-ratio: auto;
        background-position: center top;
      }
      & :global(.empty-photo svg) {
        block-size: 92%;
      }
    }
    [data-kind="signed"],
    [data-kind="activated"] {
      --ring: var(--tag-green-fg);
    }
    [data-kind="transfer"] {
      --ring: var(--tag-blue-fg);
    }
    [data-kind="benched"] {
      --ring: var(--tag-purple-fg);
    }
    .cm-top {
      grid-area: top;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-02);
      min-inline-size: 0;
    }
    .cm-name {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-02);
      min-inline-size: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--link);
      font-size: var(--type-body-sm);
    }
    .cm-kind {
      flex: none;
      min-block-size: 1.125rem;
      padding-inline: var(--sp-02);
      font-size: 0.625rem;
      font-weight: 600;
      text-transform: uppercase;
    }
    .cm-path {
      grid-area: path;
      display: flex;
      align-items: center;
      gap: var(--sp-02);
      min-inline-size: 0;
      color: var(--text-secondary);
      font-size: var(--type-label);
    }
    .cm-end {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-02);
      min-inline-size: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 600;
      color: var(--text-primary);
      & :global(.team-mark) {
        --mark: 1.125rem;
      }
    }
    .cm-none {
      font-weight: 500;
      color: var(--text-secondary);
      text-transform: uppercase;
      font-size: 0.625rem;
      letter-spacing: 0.04em;
    }
    .cm-arrow {
      flex: none;
      transition: translate var(--duration-fast-02, 110ms) ease-out;
    }
    .cm-ago {
      margin-inline-start: auto;
      flex: none;
      font-family: var(--font-mono);
      font-size: 0.625rem;
    }
    .move-who {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-03);
      text-decoration: none;
      color: inherit;
      min-inline-size: 0;
      & > span {
        display: grid;
        min-inline-size: 0;
      }
      & strong {
        color: var(--link);
      }
      & time {
        font-family: var(--font-mono);
        font-size: var(--type-label);
      }
    }
    .move-path {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-03);
      color: var(--text-secondary);
    }
    .end {
      display: inline-grid;
      justify-items: center;
      gap: var(--sp-01);
      min-inline-size: 2.75rem;
    }
    .lbl {
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1;
    }
    .none {
      inline-size: 1.5rem;
      block-size: 1.5rem;
      border: var(--border-width) dashed var(--border-strong);
    }
    .note {
      grid-column: 1 / -1;
      font-size: var(--type-label);
    }
  }
</style>

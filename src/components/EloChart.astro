---
/**
 * One-series line chart of a rating over time (team or player Elo).
 * Server-rendered SVG: recessive grid, a 2px line, 8px markers with a native
 * tooltip per point, and a dashed reference line at the starting rating.
 * The data is also listed in the move/result table beside it.
 */
interface Point {
  /** Short x label, e.g. a date. */
  label: string;
  value: number;
  /** Tooltip text for the point. */
  title: string;
}
interface Props {
  points: Point[];
  /** Starting rating, drawn as a reference line. */
  start: number;
  /** Accessible name, e.g. "Northwind Elo over time". */
  label: string;
}
const { points, start, label } = Astro.props;
const W = 640;
const H = 180;
const pad = { l: 44, r: 12, t: 12, b: 26 };
const all = [start, ...points.map((p) => p.value)];
const step = 25;
const lo = Math.floor((Math.min(...all) - 10) / step) * step;
const hi = Math.ceil((Math.max(...all) + 10) / step) * step;
const x = (i: number) => pad.l + (points.length <= 1 ? (W - pad.l - pad.r) / 2 : (i * (W - pad.l - pad.r)) / (points.length - 1));
const y = (v: number) => pad.t + ((hi - v) * (H - pad.t - pad.b)) / Math.max(1, hi - lo);
const ticks = [lo, Math.round((lo + hi) / 2 / step) * step, hi].filter((v, i, a) => a.indexOf(v) === i);
const path = points.map((p, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(" ");
const last = points.at(-1);
const labelEvery = Math.max(1, Math.ceil(points.length / 6));
---

{
  points.length === 0 ? (
    <p class="muted">No rated results yet.</p>
  ) : (
    <figure class="elo-chart">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${label}: from ${start} to ${last!.value} over ${points.length} results`}>
        {ticks.map((t) => (
          <g class="tick">
            <line x1={pad.l} x2={W - pad.r} y1={y(t)} y2={y(t)} />
            <text x={pad.l - 6} y={y(t)} dy="0.32em" text-anchor="end">{t}</text>
          </g>
        ))}
        <line class="ref" x1={pad.l} x2={W - pad.r} y1={y(start)} y2={y(start)} />
        <text class="ref-label" x={W - pad.r} y={y(start) - 4} text-anchor="end">Start {start}</text>
        <path class="line" d={path} />
        {points.map((p, i) => (
          <g class="pt">
            <circle class="hit" cx={x(i)} cy={y(p.value)} r="10" />
            <circle class="dot" cx={x(i)} cy={y(p.value)} r="4" />
            <title>{p.title}</title>
          </g>
        ))}
        {points.map((p, i) => (i % labelEvery === 0 || i === points.length - 1 ? <text class="xl" x={x(i)} y={H - 6} text-anchor="middle">{p.label}</text> : null))}
      </svg>
    </figure>
  )
}

<style>
  @layer components {
    .elo-chart {
      margin: 0;
      & svg {
        display: block;
        inline-size: 100%;
        block-size: auto;
        overflow: visible;
      }
      & text {
        fill: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 9px;
      }
      & .tick line {
        stroke: var(--border-subtle);
        stroke-width: 1;
      }
      & .ref {
        stroke: var(--text-muted);
        stroke-dasharray: 4 4;
        stroke-width: 1;
      }
      & .ref-label {
        fill: var(--text-muted);
      }
      & .line {
        fill: none;
        stroke: var(--link);
        stroke-width: 2;
        stroke-linejoin: round;
        stroke-linecap: round;
      }
      & .dot {
        fill: var(--link);
        stroke: var(--surface);
        stroke-width: 2;
      }
      & .hit {
        fill: transparent;
      }
      & .pt:hover .dot {
        r: 6;
      }
    }
  }
</style>

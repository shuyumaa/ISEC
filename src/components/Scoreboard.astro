---
import { event, flagUrl, matchInstant, rankOf, team, winnerOf, type Match } from "../data";
import Countdown from "./Countdown.astro";
import LocalTime from "./LocalTime.astro";
import TeamMark from "./TeamMark.astro";

interface Props {
  match: Match;
  /** Make the whole board a link to the match page. */
  link?: boolean;
  headingLevel?: 1 | 2;
}

const { match: m, link = false, headingLevel = 2 } = Astro.props;
const ev = event(m.event);
const a = team(m.teamA);
const b = team(m.teamB);
const winner = winnerOf(m);
const instant = matchInstant(m);
const liveMap = m.maps.find((x) => x.live);
const H = `h${headingLevel}` as "h1" | "h2";
const state = (slug: string) => (winner ? (winner === slug ? "won" : "lost") : undefined);
// One primary link (stretched over the board) plus team links, never a link
// inside a link: see Modern Web Guidance "card".
const Center = link ? "a" : "div";
// A TBD side has no team page to link to.
const SideA = a.slug ? "a" : "div";
const SideB = b.slug ? "a" : "div";
const seriesA = m.bestOf === 1 ? (m.maps[0]?.scoreA ?? 0) : m.seriesA;
const seriesB = m.bestOf === 1 ? (m.maps[0]?.scoreB ?? 0) : m.seriesB;
const flagA = flagUrl(a.countryCode);
const flagB = flagUrl(b.countryCode);
---

<div class:list={["scoreboard", m.status, { link }]}>
  {flagA && <span class="sb-flag a" style={`--flag: url("${flagA}")`} aria-hidden="true" />}
  {flagB && <span class="sb-flag b" style={`--flag: url("${flagB}")`} aria-hidden="true" />}
  <div class="sb-meta">
    {m.status === "live" && <span class="badge live">Live</span>}
    {m.status === "completed" && <span class="badge">Final</span>}
    {m.status === "upcoming" && <span class="badge blue">Upcoming</span>}
    <span>{ev.name}</span>
    <span class="subtle">{m.stage} · Best of {m.bestOf}</span>
  </div>

  <H class="sb-title visually-hidden">{a.name} vs {b.name}</H>
  <span class="visually-hidden" data-announce-text>
    {m.status === "upcoming" ? `${a.name} versus ${b.name} has not started.` : `${m.status === "live" ? "Live" : "Final"}: ${a.name} ${seriesA}, ${b.name} ${seriesB}${liveMap && m.bestOf > 1 ? `. ${liveMap.map} ${liveMap.scoreA} to ${liveMap.scoreB}` : ""}.`}
  </span>

  <div class="sb-main">
    <SideA class:list={["sb-team", state(a.slug), { tbd: !a.slug }]} href={a.slug ? `/teams/${a.slug}/` : undefined}>
      <TeamMark team={a} size="xl" />
      <span class="sb-name">{a.name}</span>
      {rankOf(a.slug) && <span class="subtle">Rank #{rankOf(a.slug)}</span>}
    </SideA>

    <Center class:list={["sb-center", { "card-link": link }]} href={link ? `/matches/${m.id}/` : undefined} aria-label={link ? `Match page: ${a.name} vs ${b.name}` : undefined}>
      {
        m.status === "upcoming" ? (
          <>
            <LocalTime instant={instant} zone={ev.timeZone} format="time" class="sb-time" />
            <LocalTime instant={instant} zone={ev.timeZone} format="date" class="subtle" />
            <Countdown instant={instant} />
          </>
        ) : (
          <>
            <span class="sb-score" aria-label={`${a.name} ${seriesA}, ${b.name} ${seriesB}`}>
              <span class={state(a.slug)}>{seriesA}</span>
              <span class="sep" aria-hidden="true">:</span>
              <span class={state(b.slug)}>{seriesB}</span>
            </span>
            {liveMap && m.bestOf > 1 && (
              <span class="subtle">
                {liveMap.map} · {liveMap.scoreA}–{liveMap.scoreB}
              </span>
            )}
            {liveMap && m.bestOf === 1 && <span class="subtle">{liveMap.map} · in progress</span>}
            {m.status === "completed" && <LocalTime instant={instant} zone={ev.timeZone} format="date" class="subtle" />}
          </>
        )
      }
    </Center>

    <SideB class:list={["sb-team", state(b.slug), { tbd: !b.slug }]} href={b.slug ? `/teams/${b.slug}/` : undefined}>
      <TeamMark team={b} size="xl" />
      <span class="sb-name">{b.name}</span>
      {rankOf(b.slug) && <span class="subtle">Rank #{rankOf(b.slug)}</span>}
    </SideB>
  </div>
</div>

<style>
  @layer components {
    .scoreboard {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      display: grid;
      gap: var(--sp-06);
      padding: var(--sp-06) var(--sp-05);
      border: var(--border-width) solid var(--border-strong);
      background: var(--surface);
      text-decoration: none;

      /* The board reacts as a whole to its match link (hover and focus ring). */
      &:has(.card-link:hover) {
        background: var(--layer);
      }
      &:has(.card-link:focus-visible) {
        outline: var(--focus-width) solid var(--focus);
        outline-offset: calc(var(--focus-width) * -1);
      }
      & .card-link {
        color: inherit;
        text-decoration: none;
        &::after {
          content: "";
          position: absolute;
          inset: 0;
        }
        &:focus-visible {
          outline: none;
        }
      }
      &.live {
        border-block-start: 4px solid var(--live);
      }
    }

    /* HLTV-style: each team's flag, faded from its side towards the middle. */
    .sb-flag {
      position: absolute;
      inset-block: 0;
      inline-size: 50%;
      z-index: -1;
      background: var(--flag) center / cover no-repeat;
      opacity: 0.2;
      filter: saturate(0.85) blur(1px);
      pointer-events: none;
      &.a {
        inset-inline-start: 0;
        -webkit-mask-image: linear-gradient(to right, rgb(0 0 0 / 0.9), transparent 92%);
        mask-image: linear-gradient(to right, rgb(0 0 0 / 0.9), transparent 92%);
      }
      &.b {
        inset-inline-end: 0;
        -webkit-mask-image: linear-gradient(to left, rgb(0 0 0 / 0.9), transparent 92%);
        mask-image: linear-gradient(to left, rgb(0 0 0 / 0.9), transparent 92%);
      }
    }
    @supports not ((mask-image: linear-gradient(black, transparent)) or (-webkit-mask-image: linear-gradient(black, transparent))) {
      .sb-flag {
        opacity: 0.12;
      }
    }
    @media (forced-colors: active) {
      .sb-flag {
        display: none;
      }
    }

    .sb-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: var(--sp-02) var(--sp-04);
      text-align: center;
    }

    .sb-main {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: var(--sp-05);
    }

    .sb-team {
      /* Above the stretched match link, so each team opens its own page. */
      position: relative;
      z-index: 1;
      color: inherit;
      text-decoration: none;
      &:hover .sb-name {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
      display: grid;
      justify-items: center;
      gap: var(--sp-03);
      text-align: center;
    }

    .sb-name {
      font-size: clamp(var(--type-body), 0.8rem + 1.2vw, var(--type-heading));
      font-weight: 400;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
    .sb-team.won .sb-name {
      font-weight: 600;
    }

    .sb-center {
      display: grid;
      justify-items: center;
      gap: var(--sp-02);
      text-align: center;
    }

    .sb-score {
      display: flex;
      align-items: baseline;
      gap: var(--sp-03);
      font-size: var(--type-display);
      font-weight: 300;
      line-height: 1;
      font-family: var(--font-mono);

      & .won {
        font-weight: 600;
      }
      & .sep {
        color: var(--text-muted);
      }
    }

    :global(.sb-time) {
      font-size: var(--type-heading-lg);
      font-family: var(--font-mono);
      font-weight: 300;
      line-height: 1;
    }
  }
</style>

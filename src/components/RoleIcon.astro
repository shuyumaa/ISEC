---
import Icon from "./Icon.astro";
import { rolesOf, type Player } from "../data";

/**
 * HLTV-style role badges for the two roles fans look for in a lineup: the
 * in-game leader (crown) and the AWPer (crosshair). A player can hold both
 * (primary and second role), so both badges show, IGL first. Other roles show
 * nothing, so the badges stay meaningful. The role name is the accessible label.
 */
interface Props {
  player: Pick<Player, "role" | "role2">;
  size?: "sm" | "md";
  /** Stack the badges vertically (photo corners). */
  stack?: boolean;
}
const { player, size = "sm", stack = false } = Astro.props;
const roles = rolesOf(player);
const badges = [
  roles.includes("IGL") && { cls: "igl", icon: "crown", label: "In-game leader" },
  roles.includes("AWP") && { cls: "awp", icon: "crosshair", label: "AWPer" },
].filter(Boolean) as { cls: string; icon: "crown" | "crosshair"; label: string }[];
---

{
  badges.length > 0 && (
    <span class:list={["role-icons", { stack }]}>
      {badges.map((b) => (
        <span class:list={["role-icon", size, b.cls]} role="img" aria-label={b.label} title={b.label}>
          <Icon name={b.icon} size={size === "md" ? 18 : 14} />
        </span>
      ))}
    </span>
  )
}

<style>
  @layer components {
    .role-icons {
      display: inline-flex;
      gap: var(--sp-01);
      &.stack {
        flex-direction: column;
      }
    }
    .role-icon {
      display: inline-grid;
      place-items: center;
      flex: none;
      inline-size: 1.25rem;
      aspect-ratio: 1;
      border-radius: 4px;
      color: var(--white);
      &.md {
        inline-size: 2rem;
        border-radius: 6px;
      }
      &.igl {
        background: var(--blue-70, #0043ce);
      }
      &.awp {
        background: var(--green-60, #198038);
      }
    }
    @media (forced-colors: active) {
      .role-icon {
        border: 1px solid CanvasText;
      }
    }
  }
</style>

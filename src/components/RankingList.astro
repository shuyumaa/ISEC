---
import { ranking, team } from "../data";
import Icon from "./Icon.astro";
import TeamMark from "./TeamMark.astro";

interface Props {
  limit?: number;
}
const { limit = 10 } = Astro.props;
const rows = ranking.slice(0, limit);
---

<ol class="ranking-list">
  {
    rows.map((r, i) => {
      const t = team(r.team);
      return (
        <li>
          <a href={`/teams/${t.slug}/`}>
            <span class="pos">{i + 1}</span>
            <TeamMark team={t} />
            <span class="name">{t.name}</span>
            <span class="pts">{r.points}</span>
            <span class="chg">
              {r.change > 0 && (
                <>
                  <Icon name="up" size={12} />
                  <span class="visually-hidden">up</span>
                  {r.change}
                </>
              )}
              {r.change < 0 && (
                <>
                  <Icon name="down" size={12} />
                  <span class="visually-hidden">down</span>
                  {Math.abs(r.change)}
                </>
              )}
              {r.change === 0 && (
                <>
                  <span aria-hidden="true">–</span>
                  <span class="visually-hidden">no change</span>
                </>
              )}
            </span>
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  @layer components {
    .ranking-list a {
      display: grid;
      grid-template-columns: 1.5rem auto minmax(0, 1fr) auto 2.25rem;
      align-items: center;
      gap: var(--sp-03);
      padding: var(--sp-03) var(--sp-05) var(--sp-03) 0;
      border-block-end: var(--border-width) solid var(--border-subtle);
      text-decoration: none;
      outline-offset: calc(var(--focus-width) * -1);

      &:hover {
        background: var(--layer);
        & .name {
          text-decoration: underline;
        }
      }
    }
    .pos {
      font-family: var(--font-mono);
      text-align: end;
      color: var(--text-secondary);
    }
    .name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .pts {
      font-family: var(--font-mono);
    }
    .chg {
      display: inline-flex;
      align-items: center;
      justify-content: end;
      gap: 1px;
      font-size: var(--type-label);
      color: var(--text-secondary);
    }
  }
</style>

---
interface Props {
  /** Rendered height; width follows the artwork's aspect ratio. */
  height?: string;
  label?: string;
}

const { height = "1.25rem", label = "ISEC" } = Astro.props;

// The original ISEC artwork (chromatic aberration / motion-blur treatment) is
// drawn as a CSS background, so there is no <img> to drag, save or copy. The
// variant follows the rendered colour scheme (.brand-logo in protect.css) and
// /media/[file] refuses direct or cross-site requests for the file.
---

<span class="brand-logo protected" role="img" aria-label={label} style={`--logo-h: ${height}`}></span>

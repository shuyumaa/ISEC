---
import { event, mapDecided, team, type Match } from "../../data";
import TeamMark from "../TeamMark.astro";

interface Props {
  match: Match;
  /** On the match's own admin page: the page title already names it. */
  embedded?: boolean;
}
const { match: m, embedded = false } = Astro.props;
const a = team(m.teamA);
const b = team(m.teamB);
const ev = event(m.event);
const action = `/admin/matches/${m.id}/`;
const liveIndex = m.maps.findIndex((x) => x.live);
const nextIndex = m.maps.findIndex((x) => !mapDecided(x));
const controlIndex = liveIndex >= 0 ? liveIndex : nextIndex;
const current = controlIndex >= 0 ? m.maps[controlIndex] : undefined;
---

<article class="control" aria-labelledby={`ctl-${m.id}`}>
  <header class:list={["control-head", { "visually-hidden": embedded }]}>
    <h3 id={`ctl-${m.id}`}>
      <a href={action}>{a.name} vs {b.name}</a>
    </h3>
    <span class="subtle">{ev.name} · {m.stage} · Bo{m.bestOf}</span>
    <span class:list={["badge", { live: m.status === "live", blue: m.status === "upcoming" }]}>{m.status}</span>
  </header>

  <div class="control-series" aria-label={`Series ${a.name} ${m.seriesA}, ${b.name} ${m.seriesB}`}>
    <span><TeamMark team={a} size="md" /> <span class="big">{m.seriesA}</span></span>
    <span class="subtle">maps won</span>
    <span><span class="big">{m.seriesB}</span> <TeamMark team={b} size="md" /></span>
  </div>

  {
    m.status !== "completed" && current && (
      <div class="control-map">
        <p class="map-label">
          Map {controlIndex + 1}: <strong>{current.map}</strong>
          {current.live ? <span class="badge live">Live</span> : <span class="subtle">· not started</span>}
        </p>
        <div class="rounds">
          {(["A", "B"] as const).map((side) => {
            const t = side === "A" ? a : b;
            const score = (side === "A" ? current.scoreA : current.scoreB) ?? 0;
            return (
              <div class="round-side">
                <span class="side-name">{t.name}</span>
                <span class="round-score" aria-label={`${t.name} rounds`}>{score}</span>
                <progress class="race" max={Math.max(13, score + 1)} value={score} aria-label={`${t.name}: ${score} of 13 rounds to win the map`}></progress>
                <div class="round-buttons">
                  <form method="post" action={action} data-enhance><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
                    <input type="hidden" name="intent" value="round" />
                    <input type="hidden" name="map" value={controlIndex} />
                    <input type="hidden" name="side" value={side} />
                    <button class="btn" type="submit" name="delta" value="1" aria-label={`+1 round to ${t.name}`}>+1</button>
                    <button class="btn ghost" type="submit" name="delta" value="-1" aria-label={`−1 round from ${t.name}`} disabled={score === 0}>−1</button>
                  </form>
                </div>
              </div>
            );
          })}
        </div>
        <p class="hint subtle">Maps close automatically at 13 (or an overtime win); the next map opens and the series finishes on its own.</p>
      </div>
    )
  }

  <form method="post" action={action} class="control-status" data-enhance><input type="hidden" name="_csrf" value={Astro.locals.csrf} />
    <input type="hidden" name="intent" value="status" />
    {m.status === "upcoming" && (m.teamA && m.teamB ? <button type="submit" class="btn" name="status" value="live">Go live</button> : <a class="btn ghost" href={`${action}#details-h`}>Set teams first</a>)}
    {m.status === "live" && <button type="submit" class="btn" name="status" value="completed">Finish match</button>}
    {m.status === "live" && <button type="submit" class="btn ghost" name="status" value="upcoming">Back to upcoming</button>}
    {m.status === "completed" && <button type="submit" class="btn ghost" name="status" value="live">Reopen as live</button>}
    {!embedded && <a class="link-arrow" href={action}>Maps, stats &amp; server</a>}
  </form>
</article>

<style>
  @layer components {
    .control {
      display: grid;
      gap: var(--sp-05);
      padding: var(--sp-04);
      border: var(--border-width) solid var(--border-strong);
      background: var(--surface);
    }
    .control-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--sp-02) var(--sp-04);
      & h3 {
        font-size: var(--type-body);
      }
    }
    .control-series {
      display: flex;
      align-items: center;
      justify-content: space-between;
      & > span {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-03);
      }
      & .big {
        font-family: var(--font-mono);
        font-size: var(--type-heading);
      }
    }
    .control-map {
      display: grid;
      gap: var(--sp-04);
      padding-block-start: var(--sp-04);
      border-block-start: var(--border-width) solid var(--border-subtle);
    }
    .map-label {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-03);
      align-items: center;
    }
    .rounds {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
      gap: var(--sp-05);
    }
    .round-side {
      display: grid;
      justify-items: center;
      gap: var(--sp-03);
      padding: var(--sp-04);
      background: var(--layer);
    }
    /* Race to 13 (overtime stretches the bar). */
    .race {
      inline-size: 100%;
      block-size: 0.375rem;
      accent-color: var(--button-primary);
    }
    .round-score {
      font-family: var(--font-mono);
      font-size: var(--type-display);
      font-weight: 300;
      line-height: 1;
    }
    .round-buttons form {
      display: flex;
      gap: var(--sp-03);
      & .btn {
        min-inline-size: 4rem;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: var(--type-heading-sm);
      }
    }
    .hint {
      font-size: var(--type-label);
    }
    .control-status {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-03) var(--sp-04);
      padding-block-start: var(--sp-04);
      border-block-start: var(--border-width) solid var(--border-subtle);
      & .link-arrow {
        margin-inline-start: auto;
      }
    }
  }
</style>

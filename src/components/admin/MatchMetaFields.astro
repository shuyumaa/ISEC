---
import { getEvents, getTeams, type Match } from "../../data";
import ChoiceGroup from "./ChoiceGroup.astro";
import StarRating from "./StarRating.astro";

interface Props {
  match?: Match;
  /** Event to preselect for a new match (e.g. from an event's "Schedule a match here"). */
  presetEvent?: string;
}
const { match: m, presetEvent } = Astro.props;
const teams = getTeams().toSorted((a, b) => a.name.localeCompare(b.name));
const events = getEvents();
---

<div class="form-grid">
  <div class="field">
    <label for="event">Event</label>
    <select id="event" name="event" required>
      {events.map((e) => <option value={e.slug} selected={(m?.event ?? presetEvent) === e.slug}>{e.name}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="stage">Stage</label>
    <input id="stage" name="stage" required maxlength="80" value={m?.stage ?? ""} placeholder="e.g. Semi-final 1" />
  </div>
  <div class="field">
    <label for="start">Start (event's local time)</label>
    <input id="start" name="start" type="datetime-local" required value={m?.start ?? ""} />
    <span class="hint">Shown to visitors in their own time zone.</span>
  </div>
  <div class="field">
    <label for="teamA">Team A</label>
    <select id="teamA" name="teamA" aria-describedby="tbd-hint">
      <option value="">TBD (decide later)</option>
      {teams.map((t) => <option value={t.slug} selected={m?.teamA === t.slug}>{t.name}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="teamB">Team B</label>
    <select id="teamB" name="teamB" aria-describedby="tbd-hint">
      <option value="">TBD (decide later)</option>
      {teams.map((t) => <option value={t.slug} selected={m?.teamB === t.slug}>{t.name}</option>)}
    </select>
    <span id="tbd-hint" class="hint">Leave a side as TBD to publish the schedule first; set it before going live.</span>
  </div>
  <ChoiceGroup name="bestOf" legend="Format" value={String(m?.bestOf ?? 3)} options={[{ value: "1", label: "Bo1" }, { value: "3", label: "Bo3" }, { value: "5", label: "Bo5" }]} />
  <StarRating value={m?.stars ?? 0} />
</div>

# Copy to .env (never commit the real one) or set these in your host's dashboard.

# Required in production. Admin sign-in is username ADMIN_USER + this password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Signs admin session cookies. Set it so sessions survive restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Every public URL the site is served on (comma separated). Used for the CSRF
# origin check and to trust the Host header behind a proxy.
ISEC_HOSTS=https://isec.example
SITE_URL=https://isec.example

# Where the SQLite database lives. Put it on a persistent disk/volume.
DATA_DIR=./data
# Where the protected logo files live.
BRAND_DIR=./private/brand
# Set to false to start with an empty database instead of demo data.
ISEC_SEED=true

HOST=0.0.0.0
PORT=4321
